    {
      "id": "learning-path",
      "title": "学习路线与准备",
      "eyebrow": "BUILD THE FOUNDATION",
      "summary": "先建立最小原理，再逐步进入状态、检索、框架、评估和协作。",
      "estimated_minutes": 7,
      "next_label": "认识实验工作台",
      "scenes": {
        "understand": {
          "blocks": [
            {
              "id": "objectives",
              "type": "objectives",
              "items": [
                {
                  "id": "objective-1",
                  "text": "找到适合自己起点的准备内容。"
                },
                {
                  "id": "objective-2",
                  "text": "理解课程层级与可学习状态的区别。"
                },
                {
                  "id": "objective-3",
                  "text": "知道为什么先观察原生循环，再学习框架。"
                }
              ]
            },
            {
              "id": "route",
              "type": "steps",
