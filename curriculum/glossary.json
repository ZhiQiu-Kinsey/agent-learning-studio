{
  "schema_version": 1,
  "locale": "zh-CN",
  "terms": [
    {
      "id": "agent",
      "zh": "Agent",
      "en": "Agent",
      "definition": "由模型决定下一步行动、由程序执行工具并把结果送回模型，循环推进直到完成任务或触发停止条件的系统。",
      "aliases": ["智能体"]
    },
    {
      "id": "harness",
      "zh": "运行层",
      "en": "Harness",
      "definition": "包在模型外面的程序部分：组织请求、执行工具、管理上下文、预算与停止条件，并记录运行证据。"
    },
    {
      "id": "tool-calling",
      "zh": "工具调用",
      "en": "Tool Calling",
      "definition": "模型不直接执行动作，而是给出要调用的工具名和参数，由程序真实执行后把结果交回模型的概念。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "json-schema",
      "zh": "JSON Schema",
      "en": "JSON Schema",
      "definition": "描述 JSON 数据结构的规范；在工具定义中说明参数的字段、类型和必填项，供模型生成实参、供程序校验。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "tool-result",
      "zh": "工具结果",
      "en": "Tool Result",
      "definition": "程序执行工具后的真实返回值，以 tool 消息并通过 tool_call_id 对应到发起它的那次调用。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "message-history",
      "zh": "消息历史",
      "en": "Message History",
      "definition": "每次请求随附的 system、user、assistant 与 tool 消息序列；模型没有隐藏记忆，只能看到这里携带的内容。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "agent-loop",
      "zh": "Agent 循环",
      "en": "Agent Loop",
      "definition": "“请求模型 → 执行工具 → 追加结果 → 再次请求”的重复过程，由轮数上限等停止条件保证终止。",
      "aliases": ["调用循环"],
      "first_lesson": "tool-selection"
    },
    {
      "id": "trace",
      "zh": "轨迹",
      "en": "Trace",
      "definition": "一次运行中按顺序记录的请求、响应、工具调用与结果等事件，用于核对和回放，回放不会重新执行。",
      "aliases": ["trace"],
      "first_lesson": "tool-selection"
    },
    {
      "id": "allowlist",
      "zh": "白名单",
      "en": "Allowlist",
      "definition": "只允许执行预先登记的工具或操作；模型请求名单之外的名称时，程序拒绝执行并返回错误。",
      "first_lesson": "fail-safely"
    },
    {
      "id": "stop-condition",
      "zh": "停止条件",
      "en": "Stop Condition",
      "definition": "决定运行何时结束的规则，如得到最终回答、达到轮数或预算上限、出现不可恢复的错误。",
      "first_lesson": "fail-safely"
    },
    {
      "id": "retry",
      "zh": "重试",
      "en": "Retry",
      "definition": "在暂时性故障后重新执行同一操作；对输入不合法等确定性错误，原样重试不能解决问题。",
      "first_lesson": "fail-safely"
    },
    {
      "id": "acceptance-criteria",
      "zh": "验收标准",
      "en": "Acceptance Criteria",
      "definition": "事先写明、可依据实际结果检查的完成条件；用来判断任务是否真正完成，而不是看 Agent 是否声称完成。",
      "aliases": ["验收"],
      "first_lesson": "task-contract"
    },
    {
      "id": "structured-output",
      "zh": "结构化输出",
      "en": "Structured Output",
      "definition": "要求模型按约定的 JSON 结构输出，再由程序校验格式和业务规则；结构合法不等于内容正确。",
      "first_lesson": "structured-output"
    },
    {
      "id": "prompt",
      "zh": "提示词",
      "en": "Prompt",
      "definition": "发送给模型的指令与上下文文本，包括 system 规则和用户问题；改动提示词需要用对照实验检验效果。",
      "first_lesson": "prompt-experiments"
    },
    {
      "id": "tool-description",
      "zh": "工具描述",
      "en": "Tool Description",
      "definition": "工具定义中的名称、用途说明和参数说明，是模型判断是否以及如何调用该工具的主要依据。",
      "first_lesson": "prompt-experiments"
    },
    {
      "id": "validator",
      "zh": "验证器",
      "en": "Validator",
      "definition": "独立于模型、依据预定义规则检查输出或运行证据的程序；模型的自我评价不能代替它。",
      "first_lesson": "messages-context"
    },
    {
      "id": "application-state",
      "zh": "应用状态",
      "en": "Application State",
      "definition": "由程序维护的任务目标、已完成步骤、证据和终态等结构化数据，与发给模型的消息历史分开管理。",
      "aliases": ["应用 state"],
      "first_lesson": "application-state"
    },
    {
      "id": "context-window",
      "zh": "上下文窗口",
      "en": "Context Window",
      "definition": "模型单次请求能处理的最大 Token 数，输入与输出共同占用这一上限。",
      "first_lesson": "context-budget"
    },
    {
      "id": "context-budget",
      "zh": "上下文预算",
      "en": "Context Budget",
      "definition": "为一次请求的各部分（指令、历史、工具结果、输出）分配的容量上限，超出时需要取舍或压缩。",
      "first_lesson": "context-budget"
    },
    {
      "id": "context-compression",
      "zh": "上下文压缩",
      "en": "Context Compression",
      "definition": "通过截取窗口、清理旧工具结果或生成摘要来缩短上下文，同时保持消息协议合法并保留关键信息。",
      "aliases": ["压缩"],
      "first_lesson": "context-budget"
    },
    {
      "id": "token",
      "zh": "Token",
      "en": "Token",
      "definition": "模型切分文本的基本单位；上下文上限和计费都按 Token 计算，字符数只能粗略估计。",
      "first_lesson": "context-budget"
    },
    {
      "id": "usage",
      "zh": "用量",
      "en": "Usage",
      "definition": "服务商在响应中报告的 Token 消耗等数据；没有返回时应记为未知，不用本地估算冒充。",
      "aliases": ["usage"],
      "first_lesson": "context-budget"
    },
    {
      "id": "memory",
      "zh": "记忆",
      "en": "Memory",
      "definition": "程序为模型保存并在之后重新提供的信息；模型本身不会因一次对话而记住内容。",
      "first_lesson": "persistent-memory"
    },
    {
      "id": "persistent-memory",
      "zh": "持久记忆",
      "en": "Persistent Memory",
      "definition": "跨运行、跨会话保存在外部存储中的记忆，需要管理来源、检索、更新、过期与删除。",
      "aliases": ["跨会话记忆"],
      "first_lesson": "persistent-memory"
    },
    {
      "id": "chunking",
      "zh": "分块",
      "en": "Chunking",
      "definition": "把长文档切成带来源信息的片段，便于检索和放入有限的上下文。",
      "first_lesson": "document-loading"
    },
    {
      "id": "vector-retrieval",
      "zh": "向量检索",
      "en": "Vector Retrieval",
      "definition": "把文本转换为向量，按语义相似度查找相关片段的检索方式。",
      "first_lesson": "hybrid-retrieval"
    },
    {
      "id": "hybrid-retrieval",
      "zh": "混合检索",
      "en": "Hybrid Retrieval",
      "definition": "结合关键词检索与向量检索的结果并重新排序，以兼顾精确匹配和语义相近。",
      "first_lesson": "hybrid-retrieval"
    },
    {
      "id": "rag",
      "zh": "检索增强生成",
      "en": "Retrieval-Augmented Generation",
      "definition": "先从资料中检索相关片段，再把片段作为证据交给模型生成回答。",
      "aliases": ["RAG"],
      "first_lesson": "rag-citations"
    },
    {
      "id": "citation",
      "zh": "引用",
      "en": "Citation",
      "definition": "回答中指向实际检索片段的来源标注；引用必须真实存在并且支持对应结论。",
      "first_lesson": "rag-citations"
    },
    {
      "id": "agentic-rag",
      "zh": "Agentic RAG",
      "en": "Agentic RAG",
      "definition": "由 Agent 根据已得证据决定是否改写查询、继续检索或停止回答的 RAG，需要设置调用与时间预算。",
      "first_lesson": "agentic-rag"
    },
    {
      "id": "human-in-the-loop",
      "zh": "人工介入",
      "en": "Human-in-the-Loop",
      "definition": "在关键步骤暂停运行，由人审批、修改或拒绝后再继续，常与检查点配合使用。",
      "first_lesson": "human-in-the-loop"
    },
    {
      "id": "checkpoint",
      "zh": "检查点",
      "en": "Checkpoint",
      "definition": "保存运行到某一步时的状态，使任务能在暂停、失败或重启后从该处恢复。",
      "first_lesson": "human-in-the-loop"
    },
    {
      "id": "idempotency",
      "zh": "幂等",
      "en": "Idempotency",
      "definition": "同一操作执行一次和执行多次产生相同的效果；重试或恢复写入类工具时需要这一性质。",
      "first_lesson": "human-in-the-loop"
    },
    {
      "id": "evaluation",
      "zh": "评估",
      "en": "Evaluation",
      "definition": "用固定题集、预定义判据和独立验证器衡量 Agent 的表现，并保留失败记录用于比较版本。",
      "first_lesson": "evaluation-sets"
    },
    {
      "id": "observability",
      "zh": "可观测性",
      "en": "Observability",
      "definition": "通过记录请求、工具、状态、耗时与用量等运行数据，事后定位问题和比较成本的能力。",
      "first_lesson": "observability-cost"
    },
    {
      "id": "span",
      "zh": "跨度",
      "en": "Span",
      "definition": "轨迹中的单个计时步骤，如一次模型请求或一次工具执行；多个跨度组成一条轨迹。",
      "aliases": ["span"],
      "first_lesson": "observability-cost"
    },
    {
      "id": "prompt-injection",
      "zh": "提示注入",
      "en": "Prompt Injection",
      "definition": "资料、网页或工具结果中夹带的指令试图改变 Agent 行为；外部文本只能当作数据，权限由程序控制。",
      "first_lesson": "prompt-injection"
    },
    {
      "id": "function-calling",
      "zh": "函数调用",
      "en": "Function Calling",
      "definition": "服务商 API 实现工具调用的机制：请求中声明函数及参数 Schema，响应返回结构化的调用请求。",
      "first_lesson": "mcp-basics"
    },
    {
      "id": "mcp",
      "zh": "模型上下文协议",
      "en": "Model Context Protocol",
      "definition": "让 Agent 通过统一协议发现并调用外部服务所提供工具和资源的开放协议。",
      "aliases": ["MCP"],
      "first_lesson": "mcp-basics"
    },
    {
      "id": "multi-agent",
      "zh": "多 Agent",
      "en": "Multi-Agent",
      "definition": "由多个分工不同的 Agent 协作完成任务的结构；只有对照实验证明有收益时才值得引入。",
      "first_lesson": "multi-agent-patterns"
    },
    {
      "id": "sub-agent",
      "zh": "子 Agent",
      "en": "Subagent",
      "definition": "由主 Agent 委派、在独立上下文中完成子任务并返回结果的 Agent。"
    },
    {
      "id": "prompt-caching",
      "zh": "提示缓存",
      "en": "Prompt Caching",
      "definition": "服务商对重复的请求前缀复用已计算结果，以降低延迟和费用；前缀必须保持稳定才能命中。"
    },
    {
      "id": "progressive-disclosure",
      "zh": "渐进式披露",
      "en": "Progressive Disclosure",
      "definition": "先只提供目录或摘要，在需要时再加载详细内容，以节省上下文。"
    },
    {
      "id": "context-rot",
      "zh": "上下文腐蚀",
      "en": "Context Rot",
      "definition": "上下文越长，模型对其中信息的利用越不可靠的现象。"
    },
    {
      "id": "attention-budget",
      "zh": "注意力预算",
      "en": "Attention Budget",
      "definition": "把模型能有效关注的信息量视为有限资源，据此决定哪些内容放进上下文。"
    },
    {
      "id": "plan-and-execute",
      "zh": "先规划后执行",
      "en": "Plan-and-Execute",
      "definition": "先生成完整计划再逐步执行，必要时根据执行结果重新规划的控制模式。",
      "first_lesson": "plan-and-replan"
    },
    {
      "id": "reflection",
      "zh": "反思",
      "en": "Reflection",
      "definition": "让模型依据评审意见或验证结果检查自己的输出，找出问题后再修订。",
      "first_lesson": "reflection-revision"
    },
    {
      "id": "revise",
      "zh": "修订",
      "en": "Revise",
      "definition": "根据评审或验证结果修改上一版输出；需要设置迭代上限，避免无界循环。",
      "first_lesson": "reflection-revision"
    },
    {
      "id": "orchestrator-workers",
      "zh": "编排者-工人",
      "en": "Orchestrator-Workers",
      "definition": "由编排者拆分任务、分派给多个工人执行，再汇总结果的工作流模式。"
    },
    {
      "id": "evaluator-optimizer",
      "zh": "评估者-优化者",
      "en": "Evaluator-Optimizer",
      "definition": "一个角色生成结果、另一个角色评估并给出反馈，循环改进直到通过或达到迭代上限的工作流模式。"
    },
    {
      "id": "sandbox",
      "zh": "沙箱",
      "en": "Sandbox",
      "definition": "限制代码或命令可访问的文件、网络与资源的隔离执行环境；普通本地进程不是沙箱。"
    },
    {
      "id": "artifact",
      "zh": "产物",
      "en": "Artifact",
      "definition": "A2A 协议中任务完成后返回的结构化结果，如文件或数据。"
    },
    {
      "id": "stop-sequence",
      "zh": "停止序列",
      "en": "Stop Sequence",
      "definition": "请求里指定的字符串；模型输出到这里时由服务商截断，常用于让文本协议的模型写完动作后停下。",
      "first_lesson": "text-actions"
    },
    {
      "id": "observation",
      "zh": "观察结果",
      "en": "Observation",
      "definition": "工具真实执行后返回给模型的结果；只能由程序提供，模型自己写出的 Observation 是编造的。",
      "first_lesson": "text-actions"
    },
    {
      "id": "prompt-chaining",
      "zh": "提示链",
      "en": "Prompt Chaining",
      "definition": "把任务拆成固定顺序的几次模型调用，上一步的输出作为下一步的输入，步骤之间可以放程序检查。",
      "first_lesson": "workflow-patterns"
    },
    {
      "id": "routing",
      "zh": "路由",
      "en": "Routing",
      "definition": "先让模型给输入分类，再由程序按类别交给不同的处理流程；类别无法识别时走兜底路径。",
      "first_lesson": "workflow-patterns"
    }
  ]
}
