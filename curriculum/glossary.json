{
  "schema_version": 1,
  "locale": "zh-CN",
  "terms": [
    {
      "id": "agent",
      "zh": "Agent",
      "en": "Agent",
      "definition": "由模型决定下一步行动、由程序执行工具并把结果送回模型，循环推进直到完成任务或触发停止条件的系统。",
      "aliases": ["智能体"],
      "first_lesson": "chat-request"
    },
    {
      "id": "harness",
      "zh": "运行层",
      "en": "Harness",
      "definition": "包在模型外面的程序：组织请求、执行工具、管理上下文、预算与停止条件，并记录运行证据。各课的运行器就是它的最小实现。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "tool-calling",
      "zh": "工具调用",
      "en": "Tool Calling",
      "definition": "模型不直接执行动作，而是给出要调用的工具名和参数，由程序真实执行后把结果交回模型的概念。",
      "first_lesson": "tool-proposals"
    },
    {
      "id": "json-schema",
      "zh": "JSON Schema",
      "en": "JSON Schema",
      "definition": "描述 JSON 数据结构的规范；在工具定义中说明参数的字段、类型和必填项，供模型生成实参、供程序校验。",
      "aliases": [
        "Schema"
      ],
      "first_lesson": "tool-proposals"
    },
    {
      "id": "tool-result",
      "zh": "工具结果",
      "en": "Tool Result",
      "definition": "程序执行工具后的真实返回值，以 tool 消息并通过 tool_call_id 对应到发起它的那次调用。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "message-history",
      "zh": "消息历史",
      "en": "Message History",
      "definition": "每次请求随附的 system、user、assistant 与 tool 消息序列；模型没有隐藏记忆，只能看到这里携带的内容。",
      "first_lesson": "multi-turn-history"
    },
    {
      "id": "agent-loop",
      "zh": "Agent 循环",
      "en": "Agent Loop",
      "definition": "“请求模型 → 执行工具 → 追加结果 → 再次请求”的重复过程，由轮数上限等停止条件保证终止。",
      "aliases": ["调用循环"],
      "first_lesson": "tool-selection"
    },
    {
      "id": "trace",
      "zh": "轨迹",
      "en": "Trace",
      "definition": "一次运行中按顺序记录的请求、响应、工具调用与结果等事件，用于核对和回放，回放不会重新执行。",
      "first_lesson": "dependent-calls"
    },
    {
      "id": "allowlist",
      "zh": "白名单",
      "en": "Allowlist",
      "definition": "只允许执行预先登记的工具或操作；模型请求名单之外的名称时，程序拒绝执行并返回错误。",
      "first_lesson": "tool-selection"
    },
    {
      "id": "stop-condition",
      "zh": "停止条件",
      "en": "Stop Condition",
      "definition": "决定运行何时结束的规则，如得到最终回答、达到轮数或预算上限、出现不可恢复的错误。",
      "first_lesson": "fail-safely"
    },
    {
      "id": "acceptance-criteria",
      "zh": "验收标准",
      "en": "Acceptance Criteria",
      "definition": "事先写明、可依据实际结果检查的完成条件；用来判断任务是否真正完成，而不是看 Agent 是否声称完成。",
      "first_lesson": "task-contract"
    },
    {
      "id": "structured-output",
      "zh": "结构化输出",
      "en": "Structured Output",
      "definition": "要求模型按约定的 JSON 结构输出，再由程序校验格式和业务规则；结构合法不等于内容正确。",
      "first_lesson": "structured-output"
    },
    {
      "id": "tool-description",
      "zh": "工具描述",
      "en": "Tool Description",
      "definition": "工具定义里写给模型看的说明：工具的 description，以及每个参数的 description。模型据此判断要不要调用、参数怎么填；它只是说明，不给执行权限。",
      "first_lesson": "tool-proposals"
    },
    {
      "id": "validator",
      "zh": "验证器",
      "en": "Validator",
      "definition": "独立于模型、按事先写好的规则检查输出或运行证据的程序；用来判断任务是否完成时也叫验收器。模型的自我评价代替不了它。",
      "aliases": ["验收器"],
      "first_lesson": "task-contract"
    },
    {
      "id": "application-state",
      "zh": "应用状态",
      "en": "Application State",
      "definition": "由程序维护的任务目标、已完成步骤、证据和终态等结构化数据，与发给模型的消息历史分开管理。",
      "aliases": ["应用 state"],
      "first_lesson": "application-state"
    },
    {
      "id": "context-window",
      "zh": "上下文窗口",
      "en": "Context Window",
      "definition": "模型单次请求能处理的最大 Token 数，输入与输出共同占用这一上限。",
      "first_lesson": "context-budget"
    },
    {
      "id": "context-budget",
      "zh": "上下文预算",
      "en": "Context Budget",
      "definition": "为一次请求的各部分（指令、历史、工具结果、输出）分配的容量上限，超出时需要取舍或压缩。",
      "first_lesson": "context-budget"
    },
    {
      "id": "context-compression",
      "zh": "上下文压缩",
      "en": "Context Compression",
      "definition": "把旧的上下文改写得更短再继续用：按规则拼成记录、清理旧工具结果或让模型写摘要。压缩后协议要合法，关键信息是否还在要另行检查。",
      "first_lesson": "context-compaction"
    },
    {
      "id": "token",
      "zh": "Token",
      "en": "Token",
      "definition": "模型切分文本的基本单位；上下文上限和计费都按 Token 计算，字符数只能粗略估计。",
      "first_lesson": "chat-request"
    },
    {
      "id": "usage",
      "zh": "用量",
      "en": "Usage",
      "definition": "服务商在响应中报告的 Token 消耗等数据；没有返回时写“未报告”，不用本地估算冒充。",
      "first_lesson": "chat-request"
    },
    {
      "id": "prompt-tokens",
      "zh": "提示 Token",
      "en": "Prompt Tokens",
      "kind": "background",
      "definition": "用量里的 prompt_tokens：这一次请求发给模型的全部内容折算成的 Token 数，包括系统提示词、消息历史、工具定义和对话模板加的标记，所以通常比你看得见的文字多。"
    },
    {
      "id": "completion-tokens",
      "zh": "完成 Token",
      "en": "Completion Tokens",
      "kind": "background",
      "definition": "用量里的 completion_tokens：模型这一次写出的 Token 数。推理模型的推理内容通常也计在里面，所以回答很短时它也可能很大；具体以服务商文档为准。"
    },
    {
      "id": "memory",
      "zh": "记忆",
      "en": "Memory",
      "definition": "程序为模型保存并在之后重新提供的信息；模型本身不会因一次对话而记住内容。",
      "first_lesson": "persistent-memory"
    },
    {
      "id": "persistent-memory",
      "zh": "持久记忆",
      "en": "Persistent Memory",
      "definition": "跨运行、跨会话保存在外部存储中的记忆，需要管理来源、检索、更新、过期与删除。",
      "aliases": ["跨会话记忆"],
      "first_lesson": "persistent-memory"
    },
    {
      "id": "chunking",
      "zh": "分块",
      "en": "Chunking",
      "definition": "把长文档切成带来源信息的片段，便于检索和放入有限的上下文。",
      "first_lesson": "document-loading"
    },
    {
      "id": "chunk-overlap",
      "zh": "分块重叠",
      "en": "Chunk Overlap",
      "definition": "相邻两个片段共用的内容：把前一个片段末尾的几行放到下一个片段开头，交界处的上下文不丢；代价是这些行存了两次。",
      "first_lesson": "document-loading"
    },
    {
      "id": "chunk-id",
      "zh": "片段 ID",
      "en": "Chunk ID",
      "definition": "片段的稳定编号，本课程写成“文档 ID:起始行-结束行”，如 rooms:19-27；引用和核对都靠它回到原文件。文件一改就要重新生成。",
      "first_lesson": "document-loading"
    },
    {
      "id": "trust-boundary",
      "zh": "信任边界",
      "en": "Trust Boundary",
      "definition": "可信的程序指令和不可信的外部内容之间的分界。资料、网页、工具读回的文字都在边界外，其中的“指令”只是数据。",
      "first_lesson": "document-loading"
    },
    {
      "id": "keyword-retrieval",
      "zh": "关键词检索",
      "en": "Keyword Retrieval",
      "definition": "按查询和片段共有的词给片段打分排序的检索方式。编号、名称这类精确用词找得准，换了资料里没有的说法就找不到。",
      "aliases": ["稀疏检索"],
      "first_lesson": "keyword-retrieval"
    },
    {
      "id": "inverse-document-frequency",
      "zh": "逆文档频率",
      "en": "Inverse Document Frequency",
      "definition": "衡量一个词有多少见：出现在越少的片段里，权重越高；几乎每个片段都有的词区分不了片段，权重接近 0。",
      "aliases": ["IDF"],
      "first_lesson": "keyword-retrieval"
    },
    {
      "id": "bm25",
      "zh": "BM25",
      "en": "BM25",
      "definition": "常用的关键词检索打分公式：每个查询词的贡献 = 逆文档频率 × 饱和后的词频，长片段按长度打折，各词相加；参数 k1 管饱和快慢，b 管长度折扣强弱。",
      "first_lesson": "keyword-retrieval"
    },
    {
      "id": "query-set",
      "zh": "查询集",
      "en": "Query Set",
      "definition": "固定的一组测试查询，每条人工标注应该找到的资料小节。不同检索方式在同一个查询集上统计命中与漏检，结果才能比较。",
      "first_lesson": "keyword-retrieval"
    },
    {
      "id": "retrieval-miss",
      "zh": "漏检",
      "en": "Retrieval Miss",
      "definition": "查询人工标注的小节没有出现在前 k 条检索结果里。关键词检索最常见的原因是查询用了资料里没有的说法。",
      "first_lesson": "keyword-retrieval"
    },
    {
      "id": "vector-retrieval",
      "zh": "向量检索",
      "en": "Vector Retrieval",
      "definition": "把文本转换为向量，按语义相似度查找相关片段的检索方式。",
      "first_lesson": "embedding-retrieval"
    },
    {
      "id": "embedding",
      "zh": "Embedding",
      "en": "Embedding",
      "definition": "Embedding 模型把一段文本变成的一组固定长度的数字（向量）；意思相近的文本，向量方向也相近。生成它要发 Embedding 请求，按输入计费。",
      "first_lesson": "embedding-retrieval"
    },
    {
      "id": "cosine-similarity",
      "zh": "余弦相似度",
      "en": "Cosine Similarity",
      "definition": "两个向量夹角的余弦，范围 -1 到 1，越接近 1 方向越一致；只看方向不看长度。它说明意思接近，不说明片段回答了问题。",
      "first_lesson": "embedding-retrieval"
    },
    {
      "id": "vector-index",
      "zh": "向量索引",
      "en": "Vector Index",
      "definition": "保存下来的片段向量，连同生成它们的 Embedding 模型、维度和资料版本；三者任一变化，旧向量就不能再用，要重建。",
      "first_lesson": "embedding-retrieval"
    },
    {
      "id": "hybrid-retrieval",
      "zh": "混合检索",
      "en": "Hybrid Retrieval",
      "definition": "结合关键词检索与向量检索的结果并重新排序，以兼顾精确匹配和语义相近。",
      "first_lesson": "hybrid-retrieval"
    },
    {
      "id": "reciprocal-rank-fusion",
      "zh": "倒数排名融合",
      "en": "Reciprocal Rank Fusion",
      "definition": "按名次合并多份检索结果：片段在每份结果里得 1/(k + 名次)，相加后重新排序；不用原始分数，所以不怕两路分数尺度不同。",
      "aliases": ["RRF"],
      "first_lesson": "hybrid-retrieval"
    },
    {
      "id": "reranking",
      "zh": "重排",
      "en": "Reranking",
      "definition": "检索之后，用更慢、更细的方法（如重排模型或聊天模型）把查询和每条候选放在一起重新打分排序；只对前几条候选做，找不回没进候选的片段。",
      "aliases": ["重排序"],
      "first_lesson": "hybrid-retrieval"
    },
    {
      "id": "metadata-filtering",
      "zh": "元数据过滤",
      "en": "Metadata Filtering",
      "definition": "按来源、版本、时间、权限等元数据先去掉不该参与排名的片段，再取前 k 条；被去掉的片段要记录原因。",
      "first_lesson": "hybrid-retrieval"
    },
    {
      "id": "rag",
      "zh": "检索增强生成",
      "en": "Retrieval-Augmented Generation",
      "definition": "先从资料中检索相关片段，再把片段作为证据交给模型生成回答。",
      "aliases": ["RAG"],
      "first_lesson": "rag-citations"
    },
    {
      "id": "citation",
      "zh": "来源引用",
      "en": "Citation",
      "definition": "回答中指向实际检索片段的来源标注；引用必须真实存在并且支持对应结论。",
      "first_lesson": "rag-citations"
    },
    {
      "id": "groundedness",
      "zh": "有据性",
      "en": "Groundedness",
      "definition": "回答里的每条结论都能在本次提供的资料里找到依据；它只说明结论有出处，不说明资料本身正确或完整。",
      "first_lesson": "rag-citations"
    },
    {
      "id": "agentic-rag",
      "zh": "Agentic RAG",
      "en": "Agentic RAG",
      "definition": "由 Agent 根据已得证据决定是否改写查询、继续检索或停止回答的 RAG，需要设置调用与时间预算。",
      "first_lesson": "agentic-rag"
    },
    {
      "id": "static-rag",
      "zh": "静态 RAG",
      "en": "Static RAG",
      "definition": "固定流程的 RAG：用问题原文检索一次，把结果交给模型回答一次。第一次没找到的证据，没有机会再找。",
      "first_lesson": "agentic-rag"
    },
    {
      "id": "multi-hop-question",
      "zh": "多跳问题",
      "en": "Multi-hop Question",
      "definition": "答案要把两处以上的资料接起来的问题：第一跳查到的事实决定第二跳该查什么，所以一次检索通常凑不齐证据。",
      "first_lesson": "agentic-rag"
    },
    {
      "id": "query-rewriting",
      "zh": "查询改写",
      "en": "Query Rewriting",
      "definition": "检索前把问题改成更可能命中资料的查询：拆成子问题、换成资料里的说法，或带上上一跳查到的事实。",
      "first_lesson": "agentic-rag"
    },
    {
      "id": "attempt-log",
      "zh": "尝试记录",
      "en": "Attempt Log",
      "definition": "运行层记下的每次检索：查询、返回了哪些片段、新增了哪些证据。用来发现重复查询，并在下一轮告诉模型。",
      "first_lesson": "agentic-rag"
    },
    {
      "id": "human-in-the-loop",
      "zh": "人工介入",
      "en": "Human-in-the-Loop",
      "definition": "在关键步骤暂停运行，由人审批、修改或拒绝后再继续，常与检查点配合使用。",
      "first_lesson": "human-in-the-loop"
    },
    {
      "id": "checkpoint",
      "zh": "检查点",
      "en": "Checkpoint",
      "definition": "保存运行到某一步时的状态，使任务能在暂停、失败或重启后从该处恢复。",
      "first_lesson": "human-in-the-loop"
    },
    {
      "id": "idempotency",
      "zh": "幂等",
      "en": "Idempotency",
      "definition": "同一操作执行一次和执行多次产生相同的效果；重试或恢复写入类工具时需要这一性质。",
      "first_lesson": "human-in-the-loop"
    },
    {
      "id": "transient-failure",
      "zh": "暂时失败",
      "en": "Transient Failure",
      "definition": "原因会自己消失的失败，比如等锁超时、服务一时过载；过一会儿再试可能成功。参数不合法、业务规则拒绝不属于这一类。",
      "first_lesson": "reliable-tools"
    },
    {
      "id": "backoff",
      "zh": "退避",
      "en": "Backoff",
      "definition": "失败后先等一段时间再重试。指数退避让等待按 1、2、4 倍增长并封顶，常再乘一个随机系数，让多个调用方错开。",
      "first_lesson": "reliable-tools"
    },
    {
      "id": "idempotency-key",
      "zh": "幂等键",
      "en": "Idempotency Key",
      "definition": "调用方在第一次尝试前为一次写操作生成的唯一标识，重试时原样带上；存储见过它就交回首次结果，不再执行。",
      "first_lesson": "reliable-tools"
    },
    {
      "id": "compensation",
      "zh": "补偿",
      "en": "Compensation",
      "definition": "多步写入中途失败时，用一笔反向写入撤回已生效的步骤，比如退回已扣的额度。它保留历史，本身也要能安全重复。",
      "first_lesson": "reliable-tools"
    },
    {
      "id": "evaluation",
      "zh": "评估",
      "en": "Evaluation",
      "definition": "用固定题集、预定义判据和独立验证器衡量 Agent 的表现，并保留失败记录用于比较版本。",
      "not_in": ["评估者", "不可评估"],
      "first_lesson": "evaluation-sets"
    },
    {
      "id": "dev-set",
      "zh": "开发集",
      "en": "Development Set",
      "definition": "改进 Agent 时反复运行、用来发现问题和比较改动的固定题集。照着它改出来的分数偏乐观，要用留出集复核。",
      "first_lesson": "evaluation-sets"
    },
    {
      "id": "holdout-set",
      "zh": "留出集",
      "en": "Holdout Set",
      "definition": "事先分出来、改进期间不看也不用来调整的题。版本定下后才运行一次，检查开发集上的改善是否还在。",
      "aliases": ["留出案例"],
      "first_lesson": "evaluation-sets"
    },
    {
      "id": "paired-analysis",
      "zh": "配对分析",
      "en": "Paired Analysis",
      "definition": "两个版本跑同一批题，逐题比较结论，只看结论不一致的题朝哪个方向变，而不是直接相减两个通过率。",
      "first_lesson": "evaluation-sets"
    },
    {
      "id": "regression",
      "zh": "回归",
      "en": "Regression",
      "definition": "改动之后，原来通过的题不再通过。回归检查让新版本重跑旧题，尤其是以前修好的失败案例。",
      "not_in": ["自回归"],
      "first_lesson": "evaluation-sets"
    },
    {
      "id": "observability",
      "zh": "可观测性",
      "en": "Observability",
      "definition": "通过记录请求、工具、状态、耗时与用量等运行数据，事后定位问题和比较成本的能力。",
      "first_lesson": "observability-cost"
    },
    {
      "id": "span",
      "zh": "跨度",
      "en": "Span",
      "definition": "轨迹中的单个计时步骤，如一次模型请求或一次工具执行；多个跨度组成一条轨迹。",
      "aliases": ["span"],
      "first_lesson": "observability-cost"
    },
    {
      "id": "correlation-id",
      "zh": "关联 ID",
      "en": "Correlation ID",
      "definition": "把汇总记录和原始事件对上的标识，如运行编号、轮次、调用 id；凭它从报告的一行找回对应的请求或工具调用。",
      "first_lesson": "observability-cost"
    },
    {
      "id": "end-to-end-latency",
      "zh": "端到端延迟",
      "en": "End-to-End Latency",
      "definition": "一次运行从开始到结束的总耗时，包括各跨度之间的程序开销；单个跨度的耗时叫单步延迟。",
      "aliases": ["端到端耗时"],
      "first_lesson": "observability-cost"
    },
    {
      "id": "prompt-injection",
      "zh": "提示注入",
      "en": "Prompt Injection",
      "definition": "资料、网页或工具结果中夹带的指令试图改变 Agent 行为；外部文本只能当作数据，权限由程序控制。",
      "first_lesson": "prompt-injection"
    },
    {
      "id": "function-calling",
      "zh": "函数调用",
      "en": "Function Calling",
      "definition": "服务商 API 实现工具调用的机制：请求中声明函数及参数 Schema，响应返回结构化的调用提议。",
      "aliases": ["原生工具调用"],
      "first_lesson": "text-actions"
    },
    {
      "id": "mcp",
      "zh": "模型上下文协议",
      "en": "Model Context Protocol",
      "definition": "让 Agent 通过统一协议发现并调用外部服务所提供工具和资源的开放协议。",
      "aliases": ["MCP"],
      "first_lesson": "mcp-basics"
    },
    {
      "id": "mcp-server",
      "zh": "MCP 服务端",
      "en": "MCP Server",
      "definition": "按模型上下文协议提供工具、资源或提示模板的独立程序；工具能做什么、参数怎么校验，都由它自己的代码决定。",
      "first_lesson": "mcp-basics"
    },
    {
      "id": "mcp-client",
      "zh": "MCP 客户端",
      "en": "MCP Client",
      "definition": "宿主程序里负责和一个 MCP 服务端保持连接的部分：建立连接、列出工具、发出调用、带回结果；它不决定调用哪个工具。",
      "first_lesson": "mcp-basics"
    },
    {
      "id": "tool-discovery",
      "zh": "工具发现",
      "en": "Tool Discovery",
      "definition": "运行时向服务端要工具清单（MCP 里是 tools/list），拿到每个工具的名称、描述和输入 Schema，而不是把工具定义写死在代码里。",
      "first_lesson": "mcp-basics"
    },
    {
      "id": "multi-agent",
      "zh": "多 Agent",
      "en": "Multi-Agent",
      "definition": "由多个分工不同的 Agent 协作完成任务的结构；只有对照实验证明有收益时才值得引入。",
      "first_lesson": "multi-agent-patterns"
    },
    {
      "id": "sub-agent",
      "zh": "子 Agent",
      "en": "Subagent",
      "definition": "由主 Agent 委派、在独立上下文中完成子任务并返回结果的 Agent。",
      "first_lesson": "multi-agent-patterns"
    },
    {
      "id": "role-switching",
      "zh": "角色切换",
      "en": "Role Switching",
      "definition": "同一个 Agent 在不同阶段换上不同的系统提示词，消息历史一直共享；角色变了，运行标识和上下文没有分开。",
      "first_lesson": "multi-agent-patterns"
    },
    {
      "id": "context-isolation",
      "zh": "上下文隔离",
      "en": "Context Isolation",
      "definition": "每个 Agent 只在自己的上下文里工作，只看到交给它的内容；能减少无关信息的干扰，也会丢掉没交过去的信息。",
      "first_lesson": "multi-agent-patterns"
    },
    {
      "id": "handoff-package",
      "zh": "交接包",
      "en": "Handoff Package",
      "definition": "派给另一个 Agent 的全部输入：任务、已确认的事实与约束、要处理的资料；没写进去的，对方就不知道。",
      "first_lesson": "multi-agent-patterns"
    },
    {
      "id": "delegation-contract",
      "zh": "委派契约",
      "en": "Delegation Contract",
      "definition": "交给子 Agent 的任务约定：输入范围、输出格式、证据要求和停止条件；协调者按同一份条款检查交回的结果。",
      "first_lesson": "delegation-budget"
    },
    {
      "id": "merge-check",
      "zh": "合并校验",
      "en": "Merge Check",
      "definition": "合并子任务结果之前的检查：格式对不对、证据能否核对、来源是否在分给它的范围内；同一问题的不同值作为冲突列出，不替谁裁决。",
      "first_lesson": "delegation-budget"
    },
    {
      "id": "shared-budget",
      "zh": "共享预算",
      "en": "Shared Budget",
      "definition": "一组子任务共用的模型调用数、Token 和时间额度；按优先级申请，用完就停止派工，并列出没有开始的子任务。",
      "first_lesson": "delegation-budget"
    },
    {
      "id": "cancellation-propagation",
      "zh": "取消传播",
      "en": "Cancellation Propagation",
      "definition": "取消沿创建关系向下传：父任务取消后，它派出的子任务都能看到并停下；已发出的请求收不回，只能不再等待、不用它的结果。",
      "first_lesson": "delegation-budget"
    },
    {
      "id": "coding-agent",
      "zh": "编码 Agent",
      "en": "Coding Agent",
      "kind": "background",
      "definition": "在代码仓库里读写文件、运行命令和测试，并根据结果决定下一步的 Agent，例如 Cursor、Claude Code、GitHub Copilot 的 Agent 模式。各产品的能力与权限设置以产品文档为准。"
    },
    {
      "id": "prompt-caching",
      "zh": "提示缓存",
      "en": "Prompt Caching",
      "definition": "服务商对与之前请求逐字相同的开头复用已处理的结果，以降低延迟和费用；模型看到的内容不变，命中多少以响应报告为准。",
      "first_lesson": "prompt-caching"
    },
    {
      "id": "progressive-disclosure",
      "zh": "渐进式披露",
      "en": "Progressive Disclosure",
      "definition": "先只提供目录或摘要，在需要时再加载详细内容，以节省上下文。",
      "first_lesson": "skills-disclosure"
    },
    {
      "id": "context-rot",
      "zh": "上下文腐蚀",
      "en": "Context Rot",
      "definition": "上下文越长，模型准确找回早先某条信息的能力越弱，信息还在窗口里不等于会被用上。",
      "first_lesson": "context-budget"
    },
    {
      "id": "attention-budget",
      "zh": "注意力预算",
      "en": "Attention Budget",
      "definition": "把模型能有效关注的信息量视为有限资源，据此决定哪些内容放进上下文。"
    },
    {
      "id": "plan-and-execute",
      "zh": "先规划后执行",
      "en": "Plan-and-Execute",
      "definition": "先生成完整计划再逐步执行，必要时根据执行结果重新规划的控制模式。",
      "first_lesson": "plan-and-replan"
    },
    {
      "id": "reflection",
      "zh": "反思",
      "en": "Reflection",
      "definition": "让模型依据评审意见或验证结果检查自己的输出，找出问题后再修订。",
      "first_lesson": "reflection-revision"
    },
    {
      "id": "orchestrator-workers",
      "zh": "编排者-工人",
      "en": "Orchestrator-Workers",
      "definition": "由编排者拆分任务、分派给多个工人执行，再汇总结果的工作流模式。",
      "first_lesson": "orchestrator-evaluator"
    },
    {
      "id": "evaluator-optimizer",
      "zh": "评估者-优化者",
      "en": "Evaluator-Optimizer",
      "definition": "一个角色生成结果、另一个角色评估并给出反馈，循环改进直到通过或达到迭代上限的工作流模式。",
      "first_lesson": "orchestrator-evaluator"
    },
    {
      "id": "sandbox",
      "zh": "沙箱",
      "en": "Sandbox",
      "definition": "限制代码或命令可访问的文件、网络与资源的隔离执行环境；普通本地进程不是沙箱。"
    },
    {
      "id": "artifact",
      "zh": "A2A 产物",
      "en": "Artifact",
      "definition": "A2A 协议中任务完成后返回的结构化结果，如文件或数据。",
      "first_lesson": "a2a-delegation"
    },
    {
      "id": "a2a",
      "zh": "A2A 协议",
      "en": "Agent2Agent Protocol",
      "definition": "让一个 Agent 把任务委派给另一个独立运行的 Agent 的开放协议：先读对方的 Agent Card，再发消息创建任务，跟踪任务状态，取回产物。双方不共享上下文和内部实现。",
      "aliases": ["A2A"],
      "first_lesson": "a2a-delegation"
    },
    {
      "id": "agent-card",
      "zh": "Agent Card",
      "en": "Agent Card",
      "definition": "A2A 里描述一个 Agent 的元数据文档，放在 /.well-known/agent-card.json：名称、描述、技能、接口地址、能力（如是否支持流式）和认证方式。",
      "first_lesson": "a2a-delegation"
    },
    {
      "id": "task-lifecycle",
      "zh": "任务生命周期",
      "en": "Task Lifecycle",
      "definition": "A2A 任务从创建到结束经过的状态：SUBMITTED、WORKING，可能停在 INPUT_REQUIRED，最后进入 COMPLETED、FAILED、CANCELED 或 REJECTED 之一。",
      "first_lesson": "a2a-delegation"
    },
    {
      "id": "stop-sequence",
      "zh": "停止序列",
      "en": "Stop Sequence",
      "definition": "请求里指定的字符串；模型输出到这里时由服务商截断，常用于让文本协议的模型写完动作后停下。",
      "first_lesson": "text-actions"
    },
    {
      "id": "observation",
      "zh": "观察结果",
      "en": "Observation",
      "definition": "工具真实执行后返回给模型的结果；只能由程序提供，模型自己写出的 Observation 是编造的。",
      "first_lesson": "text-actions"
    },
    {
      "id": "prompt-chaining",
      "zh": "提示链",
      "en": "Prompt Chaining",
      "definition": "把任务拆成固定顺序的几次模型调用，上一步的输出作为下一步的输入，步骤之间可以放程序检查。",
      "first_lesson": "workflow-patterns"
    },
    {
      "id": "routing",
      "zh": "路由",
      "en": "Routing",
      "definition": "先让模型给输入分类，再由程序按类别交给不同的处理流程；类别无法识别时走兜底路径。",
      "first_lesson": "workflow-patterns"
    },
    {
      "id": "offline-test-mode",
      "zh": "离线测试模式",
      "en": "Offline Test Mode",
      "kind": "background",
      "definition": "不连接模型服务商，由课程的 fixtures.py 按请求生成确定的模型响应，工具仍真实执行。只用于自动化测试，结果不代表真实模型。"
    },
    {
      "id": "replay",
      "zh": "回放",
      "en": "Replay",
      "kind": "background",
      "definition": "按已记录的事件逐步查看一次运行：只移动游标，不重新请求模型，也不重新执行工具。"
    },
    {
      "id": "context",
      "zh": "上下文",
      "en": "Context",
      "definition": "一次请求里模型能看到的全部内容：system 规则、消息历史、工具定义和工具结果。请求之外的信息，模型看不到。",
      "first_lesson": "multi-turn-history"
    },
    {
      "id": "structured-error",
      "zh": "结构化错误",
      "en": "Structured Error",
      "definition": "工具失败时返回 ok=false、error_type 和 error 这样的数据，而不是抛出异常或给默认值，让模型读到失败原因。",
      "first_lesson": "fail-safely"
    },
    {
      "id": "terminal-state",
      "zh": "终态",
      "en": "Terminal State",
      "definition": "运行或任务的最后状态，如 completed、error、cancelled；进入后不能再转出，要写明原因。终态是 completed 不等于任务做对了。",
      "aliases": ["运行终态"],
      "first_lesson": "fail-safely"
    },
    {
      "id": "task-card",
      "zh": "任务卡",
      "en": "Task Card",
      "definition": "执行前写好的任务契约：目标、输入范围、产物、证据、失败处理和停止条件。验收只看这张卡和实际证据。",
      "first_lesson": "task-contract"
    },
    {
      "id": "completion-claim",
      "zh": "完成声明",
      "en": "Completion Claim",
      "definition": "执行者结束时交出的“已完成”说法，带答案和证据引用。它只是待核对的说法，本身不算证据。",
      "first_lesson": "task-contract"
    },
    {
      "id": "call-budget",
      "zh": "调用预算",
      "en": "Call Budget",
      "definition": "一次运行允许的模型调用数上限，来自课程清单的 max_rounds；用完平台就停止，并行分支共用同一份额度。",
      "aliases": ["模型调用预算"],
      "first_lesson": "structured-output"
    },
    {
      "id": "controlled-experiment",
      "zh": "对照实验",
      "en": "Controlled Experiment",
      "definition": "只改一个条件、其余保持不变的比较实验，差异才能归到这个条件上。单次结果只是一条观察。",
      "aliases": ["配对实验"],
      "first_lesson": "sampling-variance"
    },
    {
      "id": "message-protocol",
      "zh": "消息协议",
      "en": "Message Protocol",
      "definition": "多轮消息必须遵守的规则，例如每个工具调用后面紧跟 tool_call_id 相同的 tool 消息；违反时服务商可能拒绝请求，也可能照样回答。",
      "first_lesson": "messages-context"
    },
    {
      "id": "react",
      "zh": "ReAct",
      "en": "ReAct",
      "definition": "Reasoning + Acting：模型交替写出推理和动作，程序执行动作并交回观察结果，模型再决定下一步。文本格式和原生工具调用都能实现。",
      "first_lesson": "text-actions"
    },
    {
      "id": "text-action-protocol",
      "zh": "文本动作协议",
      "en": "Text Action Protocol",
      "definition": "模型把思考、工具名和参数按约定格式写在普通文本里，由程序解析出动作并执行，再把结果贴回。",
      "aliases": ["文本协议"],
      "first_lesson": "text-actions"
    },
    {
      "id": "todo-list",
      "zh": "待办清单",
      "en": "TODO List",
      "definition": "模型用专用工具自己维护的步骤和状态列表，用来跟踪进度。它是模型自己的说法，不能代替验收。",
      "aliases": ["TODO 清单"],
      "first_lesson": "todo-planning"
    },
    {
      "id": "memory-recall",
      "zh": "召回",
      "en": "Recall",
      "definition": "按范围等规则从记忆库取出记录、放进本次请求。存进库里不等于会被召回。",
      "not_in": ["召回率"],
      "first_lesson": "persistent-memory"
    },
    {
      "id": "workflow",
      "zh": "工作流",
      "en": "Workflow",
      "definition": "由程序预先写好步骤和分支、模型只完成每一步内容的结构；和由模型决定下一步的 Agent 循环相对。",
      "first_lesson": "workflow-patterns"
    },
    {
      "id": "parallelization",
      "zh": "并行化",
      "en": "Parallelization",
      "definition": "把互不依赖的子任务同时发给模型，再由程序汇总。省的是等待时间，不减少模型调用数和用量。",
      "first_lesson": "workflow-patterns"
    },
    {
      "id": "gate",
      "zh": "检查门",
      "en": "Gate",
      "definition": "相邻两步之间由程序执行的检查；不通过就停在这一步，不把不合格的结果往下传。",
      "first_lesson": "workflow-patterns"
    },
    {
      "id": "tokenizer",
      "zh": "分词器",
      "en": "Tokenizer",
      "kind": "background",
      "definition": "把文本切成 Token 的组件。各家模型的分词器不同，同一段文字算出的 Token 数也不同。"
    },
    {
      "id": "fault-injection",
      "zh": "故障注入",
      "en": "Fault Injection",
      "kind": "background",
      "definition": "故意构造错误输入或异常响应，检验程序的错误处理路径是否按预期工作。"
    },
    {
      "id": "baseline",
      "zh": "基线",
      "en": "Baseline",
      "kind": "background",
      "definition": "对照实验里作为参照的原有或最简单的做法；新做法的收益要和它比才成立。"
    },
    {
      "id": "ablation",
      "zh": "消融",
      "en": "Ablation",
      "kind": "background",
      "definition": "只拿掉实验里的一个部分、其余不变，再比较结果，用来确认这一部分起了什么作用。"
    },
    {
      "id": "keyword-screening",
      "zh": "关键词初筛",
      "en": "Keyword Screening",
      "kind": "background",
      "definition": "只看输出里有没有指定的词或数字的粗略检查。命中不等于语义正确，结论要回到原文复核。",
      "aliases": ["初筛"],
      "not_in": ["格式初筛"]
    },
    {
      "id": "temperature",
      "zh": "采样温度",
      "en": "Temperature",
      "definition": "采样时的参数：越低越偏向概率最高的 Token，回答越稳定；越高越分散。它不改变请求里的信息，设为 0 也不保证每次输出完全相同。",
      "first_lesson": "sampling-variance"
    },
    {
      "id": "fixture",
      "zh": "夹具",
      "en": "Fixture",
      "kind": "background",
      "definition": "测试里预先固定的数据或模拟组件。各课的 fixtures.py 按请求生成确定的模型响应，只用于离线测试，不算运行记录。",
      "aliases": ["离线夹具", "测试夹具"]
    },
    {
      "id": "confusion-matrix",
      "zh": "混淆矩阵",
      "en": "Confusion Matrix",
      "kind": "background",
      "definition": "按“人工标注类别 × 预测类别”计数的表：对角线是分对的数量，其他格子显示哪两类容易混淆。"
    },
    {
      "id": "wall-clock-time",
      "zh": "墙钟时间",
      "en": "Wall-clock Time",
      "kind": "background",
      "definition": "从开始到结束实际经过的时间。并行执行时，它可以比各任务耗时之和短。"
    },
    {
      "id": "openai-compatible",
      "zh": "OpenAI 兼容接口",
      "en": "OpenAI-Compatible API",
      "kind": "background",
      "definition": "沿用 OpenAI Chat Completions 请求和响应格式的接口，多数服务商都提供；本平台按这种格式组织消息。"
    },
    {
      "id": "annotation",
      "zh": "人工标注",
      "en": "Human Annotation",
      "kind": "background",
      "definition": "人事先给样本写好的正确答案或类别，用来衡量模型输出；标注本身也可能出错。"
    },
    {
      "id": "stable-prefix",
      "zh": "稳定前缀",
      "en": "Stable Prefix",
      "definition": "每次请求开头逐字不变的那一段，如规则、工具定义和固定资料；动态内容放在它之后，提示缓存才可能复用它。",
      "first_lesson": "prompt-caching"
    },
    {
      "id": "cached-tokens",
      "zh": "缓存命中 Token",
      "en": "Cached Tokens",
      "definition": "服务商在用量里报告的、本次输入中复用了缓存的 Token 数；各家字段名不同，响应没有报告时记为未报告，不记成 0。",
      "first_lesson": "prompt-caching"
    },
    {
      "id": "skill",
      "zh": "技能",
      "en": "Skill",
      "definition": "写给模型的一份做法说明，带名字和描述；模型按描述判断何时使用，需要时再读取正文。",
      "first_lesson": "skills-disclosure"
    },
    {
      "id": "optimistic-concurrency",
      "zh": "乐观并发控制",
      "en": "Optimistic Concurrency Control",
      "definition": "写入前不加长期锁，写入时带上读到的版本号；与存储里的当前版本不一致就拒绝这次写入，现值保持不变。",
      "first_lesson": "memory-lifecycle"
    },
    {
      "id": "message-role",
      "zh": "消息角色",
      "en": "Message Role",
      "definition": "消息列表里每条消息的 role：system 是写给模型的规则，user 是用户的话，assistant 是模型的回答，tool 是工具结果。",
      "first_lesson": "chat-request"
    },
    {
      "id": "system-prompt",
      "zh": "系统提示词",
      "en": "System Prompt",
      "kind": "background",
      "definition": "消息列表开头那条 system 角色的消息，写给模型的身份、规则和输出要求。它只是模型读到的一段文字：能影响模型怎样回答，不能像程序里的权限检查那样强制执行。"
    },
    {
      "id": "finish-reason",
      "zh": "结束原因",
      "en": "Finish Reason",
      "definition": "响应里的 finish_reason，说明输出为什么停下：stop 是模型写完了，或者命中了请求里的 stop 序列；length 是写到输出上限被截断；tool_calls 是提出了工具调用。",
      "first_lesson": "chat-request"
    },
    {
      "id": "sampling",
      "zh": "采样",
      "en": "Sampling",
      "definition": "模型每写一个 Token，都从候选 Token 的概率分布里按规则抽取一个。所以同一个请求发两次，回答可能不同。",
      "first_lesson": "sampling-variance"
    },
    {
      "id": "large-language-model",
      "zh": "大语言模型",
      "en": "Large Language Model",
      "kind": "background",
      "definition": "在海量文本上预训练、再经对话训练得到的语言模型，常简称 LLM 或大模型。它读入一段 Token，逐个预测下一个 Token 写出回答；本身不记得对话，也不能执行操作，只输出文本。课程里说的“模型”都指它。",
      "aliases": [
        "LLM",
        "大模型",
        "语言模型"
      ]
    },
    {
      "id": "model-parameters",
      "zh": "模型参数",
      "en": "Model Parameters",
      "kind": "background",
      "definition": "模型在训练中学到的大量数值，决定它读到一段输入后给出怎样的概率。请求、对话和保存记忆都不会改变它们，只有再训练才会；它们也不是请求里温度这类调用参数。",
      "aliases": [
        "模型的参数"
      ]
    },
    {
      "id": "pre-training",
      "zh": "预训练",
      "en": "Pre-training",
      "kind": "background",
      "definition": "在海量文本上训练模型预测下一个 Token。模型由此学到语言规律和大量知识，但知识停在训练数据的截止时间，也不包含从未公开的私有资料。"
    },
    {
      "id": "reinforcement-learning",
      "zh": "强化学习",
      "en": "Reinforcement Learning",
      "kind": "background",
      "definition": "让程序在环境里反复尝试、按奖励调整做法的学习方式：看到状态，选择行动，得到奖励。也用于训练模型遵循指令和使用工具。"
    },
    {
      "id": "autoregressive",
      "zh": "自回归",
      "en": "Autoregressive",
      "kind": "background",
      "definition": "模型的生成方式：每次只预测下一个 Token，把它接到前文末尾再预测下一个，直到写出停止标记或达到长度上限。"
    },
    {
      "id": "base-model",
      "zh": "基础模型",
      "en": "Base Model",
      "kind": "background",
      "definition": "只经过预训练、只会续写文本的模型。给它一个问题，它可能接着写出更多问题，而不是回答。"
    },
    {
      "id": "instruct-model",
      "zh": "指令模型",
      "en": "Instruct Model",
      "kind": "background",
      "definition": "在基础模型上再用对话和指令数据训练过的模型，会按消息角色作答、遵循指令。遵循指令是概率上的倾向，不是程序上的保证。"
    },
    {
      "id": "chat-template",
      "zh": "对话模板",
      "en": "Chat Template",
      "kind": "background",
      "definition": "把带角色的消息列表拼成一段带特殊标记的文本、交给模型续写的格式规则。各模型不同，通常由服务商在后端完成。"
    },
    {
      "id": "special-token",
      "zh": "特殊 Token",
      "en": "Special Token",
      "kind": "background",
      "definition": "分词器词表里专门保留的 Token，用来标出一条消息从哪开始、是什么角色、在哪结束。普通文字通常拼不出它们；模型写出表示结束的特殊 Token 时，服务商就停止生成。",
      "aliases": [
        "特殊标记"
      ]
    },
    {
      "id": "knowledge-cutoff",
      "zh": "知识截止",
      "en": "Knowledge Cutoff",
      "kind": "background",
      "definition": "模型训练数据收集到的最后时间。之后发生的事模型没见过，需要由程序把资料放进上下文，或提供查询工具。"
    },
    {
      "id": "web-search",
      "zh": "联网搜索",
      "en": "Web Search",
      "kind": "background",
      "definition": "聊天应用的一类功能：需要时由程序去搜索网页，把搜到的内容放进上下文，模型再据此作答。模型自己不能上网，这本质上是工具调用加检索；各产品的具体做法以产品文档为准。"
    },
    {
      "id": "hallucination",
      "zh": "幻觉",
      "en": "Hallucination",
      "kind": "background",
      "definition": "模型生成的流畅、语气肯定，却与事实或所给资料不符的内容。它来自按概率续写，没有内置的事实核对；只能降低，不能靠提示词消除。"
    },
    {
      "id": "rubric",
      "zh": "量规",
      "en": "Rubric",
      "kind": "background",
      "definition": "事先写好的一组评判条目，评审时逐条判定是否满足。条目越具体、越能逐条核对，评审结果越稳定。"
    },
    {
      "id": "reasoning-model",
      "zh": "推理模型",
      "en": "Reasoning Model",
      "kind": "background",
      "definition": "先生成一段推理内容、再给出回答的模型。推理内容在部分服务商上单独放在 reasoning_content 等字段，用掉的 Token 计入完成 Token。"
    },
    {
      "id": "tool-call-proposal",
      "zh": "调用提议",
      "en": "Tool Call Proposal",
      "definition": "模型在响应的 tool_calls 里写下的工具名和参数。它只是提议，还没执行，由程序决定是否执行。",
      "first_lesson": "tool-proposals"
    },
    {
      "id": "llm-judge",
      "zh": "评审模型",
      "en": "LLM-as-a-Judge",
      "definition": "按事先写好的量规判断另一段模型输出是否合格的模型。它本身也会波动、有偏好，判断要先和人工结论对照过。",
      "first_lesson": "prompt-experiments"
    },
    {
      "id": "iteration-limit",
      "zh": "迭代上限",
      "en": "Iteration Limit",
      "definition": "修订循环最多评审几轮。到了上限就不再请求修订，并写明停止原因；到上限停下不等于通过。",
      "first_lesson": "reflection-revision"
    },
    {
      "id": "goal-loop",
      "zh": "目标循环",
      "en": "Goal Loop",
      "kind": "background",
      "definition": "执行后由独立验收器检查，未通过就带着原因重试，通过或达到尝试上限就停止的循环。"
    },
    {
      "id": "goal-evaluation",
      "zh": "目标评估",
      "en": "Goal Evaluation",
      "definition": "目标循环每轮结束时由验收器做的检查：只读成果和本次运行读过的资料，给出完成、继续或无法完成；执行者的完成声明只记录，不采信。",
      "first_lesson": "goal-loops"
    },
    {
      "id": "abandon-condition",
      "zh": "放弃条件",
      "en": "Abandon Condition",
      "kind": "background",
      "definition": "事先写好、让循环在目标做不成或没有进展时主动停下的规则，如来源都读过仍没有值、同样的失败重复、连续没有进展。放弃不等于完成。"
    },
    {
      "id": "unreachable-goal",
      "zh": "不可达目标",
      "en": "Unreachable Goal",
      "definition": "按现有资料和约束不可能完成的目标，如要填的值在所有来源里都不存在。判定需要证据：每个允许的来源都读过。",
      "first_lesson": "goal-loops"
    },
    {
      "id": "budget-exhausted",
      "zh": "预算耗尽",
      "en": "Budget Exhausted",
      "kind": "background",
      "definition": "轮数、模型调用数或用时用完而目标仍未完成的结局。它只说明没做完，不说明做不成，和放弃分开报告。"
    },
    {
      "id": "namespace",
      "zh": "命名空间",
      "en": "Namespace",
      "definition": "记忆库里给记录分区的标签，和键一起确定一条记录。它只决定查哪一片，不验证调用方身份。",
      "first_lesson": "persistent-memory"
    },
    {
      "id": "state-machine",
      "zh": "状态机",
      "en": "State Machine",
      "kind": "background",
      "definition": "由一组状态和允许的转换组成，程序只按转换表改状态，表外转换一律拒绝。"
    },
    {
      "id": "state-graph",
      "zh": "状态图",
      "en": "StateGraph",
      "definition": "LangGraph 的图：先声明共享的状态结构，再登记节点（读状态、返回更新的函数）和边（下一步去哪），编译后按边一步步运行。",
      "first_lesson": "langgraph-state"
    },
    {
      "id": "conditional-edge",
      "zh": "条件边",
      "en": "Conditional Edge",
      "definition": "从一个节点出发、由路由函数读当前状态决定去向的边；可能的去向在建图时列出，运行时只能从中选一个。",
      "first_lesson": "langgraph-state"
    },
    {
      "id": "reducer",
      "zh": "归并函数",
      "en": "Reducer",
      "definition": "规定节点返回的更新怎样并入旧值的函数。没写时后写覆盖；消息和证据这类要保留的列表用追加的归并函数。",
      "first_lesson": "langgraph-state"
    },
    {
      "id": "recursion-limit",
      "zh": "递归上限",
      "en": "Recursion Limit",
      "definition": "LangGraph 一次运行最多执行的超步数；达到时抛出 GraphRecursionError，图停在半路，不会自动走到终态。",
      "first_lesson": "langgraph-state"
    },
    {
      "id": "super-step",
      "zh": "超步",
      "en": "Super-step",
      "kind": "background",
      "definition": "LangGraph 执行图的一轮：这一轮该运行的节点都运行完、更新并入状态，再按边决定下一轮。同一轮的节点可以并行。"
    },
    {
      "id": "agent-framework",
      "zh": "Agent 框架",
      "en": "Agent Framework",
      "definition": "提供消息对象、工具登记、调用解析和循环等现成组件的库，如 LangChain。它接手运行层里的一部分活，停止条件、预算和验收仍要自己定。",
      "first_lesson": "langchain-vs-native"
    },
    {
      "id": "framework-input",
      "zh": "框架输入",
      "en": "Framework Input",
      "definition": "框架自己持有的消息、工具名和选项，转换成服务商请求体之前的样子。本平台记为 lesson.framework_input，它不是请求体。",
      "first_lesson": "langchain-vs-native"
    },
    {
      "id": "invalid-tool-call",
      "zh": "无效调用提议",
      "en": "Invalid Tool Call",
      "definition": "实参不是合法 JSON 对象、框架解析失败的调用提议。LangChain 把它放进 AIMessage 的 invalid_tool_calls，不在 tool_calls 里。",
      "first_lesson": "langchain-vs-native"
    },
    {
      "id": "type-coercion",
      "zh": "隐式类型转换",
      "en": "Type Coercion",
      "kind": "background",
      "definition": "校验库把类型不完全相符的值悄悄转成目标类型，如字符串 \"23\" 转成 23.0、true 转成 1.0。Pydantic 默认的宽松模式会这样做。"
    },
    {
      "id": "tool-decorator",
      "zh": "工具装饰器",
      "en": "Tool Decorator",
      "definition": "把普通函数登记成工具的装饰器，如 LangChain 的 @tool：工具名取函数名，参数 Schema 从类型注解生成，执行时按同一个 Schema 校验实参。",
      "first_lesson": "langchain-tools"
    },
    {
      "id": "capability-matrix",
      "zh": "能力矩阵",
      "en": "Capability Matrix",
      "definition": "逐项列出服务商能力的表：每项写本次运行里的证据，状态分本次实测、适配回退和未验证，不笼统声称各家一致。",
      "first_lesson": "langchain-tools"
    }
  ]
}
