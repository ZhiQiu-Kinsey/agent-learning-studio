{
  "schema_version": 1,
  "id": "plan-and-replan",
  "subtitle": "计划写在前面，失败后有依据地改",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_plan_and_replan/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_plan_and_replan/fixtures.py",
      "language": "python"
    },
    {
      "path": "course/execution.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "static",
      "title": "静态计划",
      "question": "规划器先写好计划，执行器照计划执行到底，失败也不改。",
      "inputs": {
        "strategy": "static"
      }
    },
    {
      "id": "replan",
      "title": "失败后重新规划",
      "question": "某一步失败时，把真实错误交回规划器，修订剩下的步骤。",
      "inputs": {
        "strategy": "replan"
      }
    },
    {
      "id": "react",
      "title": "ReAct 基线",
      "question": "不先写计划，模型每一步看结果再决定下一步。",
      "inputs": {
        "strategy": "react"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 8,
    "requires_model": true
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务固定为学习周报；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "strategy": "replan"
  }
}
