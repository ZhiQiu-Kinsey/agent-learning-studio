{
  "schema_version": 1,
  "id": "chat-request",
  "subtitle": "不带工具，只看一次请求和一次响应",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_chat_request/runtime.py",
      "language": "python"
    },
    {
      "path": "course/api_client.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_chat_request/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_chat_request/locales/en.py",
      "language": "python",
      "locale": "en"
    },
    {
      "path": "lessons/lesson_chat_request/fixtures.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "basic",
      "title": "带系统提示词",
      "question": {
        "zh-CN": "用一句话解释什么是 Agent。",
        "en": "Explain in one sentence what an agent is."
      }
    },
    {
      "id": "no-system",
      "title": "去掉系统提示词",
      "question": {
        "zh-CN": "用一句话解释什么是 Agent。",
        "en": "Explain in one sentence what an agent is."
      },
      "inputs": {
        "system_prompt": ""
      }
    },
    {
      "id": "short-limit",
      "title": "把输出上限设得很小",
      "question": {
        "zh-CN": "用一句话解释什么是 Agent。",
        "en": "Explain in one sentence what an agent is."
      },
      "inputs": {
        "max_tokens": 16
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 1,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "用户消息",
    "question_help": "这段文字会原样作为 user 消息发给模型；留空时使用练习预设的问题。"
  },
  "input_defaults": {
    "system_prompt": {
      "zh-CN": "你是编程课的助教。回答简短、具体，不超过两句话。",
      "en": "You are a teaching assistant for a programming course. Keep answers short and concrete, two sentences at most."
    },
    "max_tokens": 0
  }
}
