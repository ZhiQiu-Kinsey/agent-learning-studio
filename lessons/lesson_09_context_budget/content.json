          "notes": [
            {
              "id": "n41",
              "line": 41,
              "text": "长度按紧凑 JSON 的字符数计算。字符数不等于 token，本课不做 token 估算。"
            },
            {
              "id": "n56",
              "line": 56,
              "text": "工具调用和回执使用同一个 id，在三种布局里总是成对保留或成对移除。"
            },
            {
              "id": "n66",
              "line": 66,
              "text": "窗口布局只留最后两条旁支消息，目标、工具调用和回执被一起丢掉。"
            },
            {
              "id": "n68",
              "line": 68,
              "text": "压缩只用已读取的来源和事实按模板拼接，不让模型在没有依据时生成摘要。"
            },
            {
              "id": "n72",
              "line": 72,
              "text": "压缩版超过字符预算时直接报错，而不是悄悄截掉证据。"
            }
          ]
        },
        {
          "id": "code-budget-run",
          "type": "annotated-source",
          "path": "lessons/lesson_09_context_budget/runtime.py",
          "start": 77,
          "end": 110,
          "notes": [
            {
              "id": "n80",
              "line": 80,
              "text": "资料通过 call_tool 真实执行 lookup_lesson，call_id 与上面构造的消息一致。"
            },
            {
              "id": "n87",
              "line": 87,
              "text": "如实声明三组消息是程序组装的受控样本，旁支回复并非先前模型生成。"
            },
            {
              "id": "n94",
              "line": 94,
              "text": "usage 只记录服务商实际返回的值，没有就显示“未知”，不做估算。"
            }
          ]
        },
        {
          "id": "code-decision",
          "type": "decision",
          "title": "保留证据的规则压缩，对照滑动窗口",
          "chosen": "用固定模板把目标、来源和事实写进一条 user 消息，并检查字符预算；与完整历史、滑动窗口两种布局各发一次，对照回答与 usage。",
          "alternatives": [
            {
              "id": "sliding-window",
              "title": "只保留最近 N 条消息",
              "why_not": "实验里的“窗口”布局就是它：工具调用与回执被成组移除，来源和事实一起丢失。"
            },
            {
              "id": "llm-summary",
              "title": "先让模型总结历史再继续",
              "why_not": "摘要不保证保留来源，还要多一次模型调用；本课要求压缩只使用已读取的证据。"
            },
            {
              "id": "token-count",
              "title": "在本地按 token 计算预算",
              "why_not": "不同服务商分词方式不同，本地只能准确计算字符数；token 只展示响应中实际返回的 usage。"
            }
          ]
        }
      ]
    },
