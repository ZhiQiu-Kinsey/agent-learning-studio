            {
              "id": "step-4",
              "label": "04",
              "actor": "程序",
              "title": "保留证据",
              "body": "按任务字段组织来源与事实。",
              "code": "compressed = [system, summary(source, fact), question]",
              "language": "python",
              "evidence": "request.messages"
            },
            {
              "id": "step-5",
              "label": "05",
              "actor": "模型",
              "title": "逐项比较",
              "body": "每种布局分别调用一次模型。",
              "code": "answers = [context.complete({'messages': m}) for m in variants]",
              "language": "python",
              "evidence": "response / lesson.report"
            }
          ]
        },
