{
  "schema_version": 1,
  "id": "reflection-revision",
  "subtitle": "模型说自己没问题，测试怎么说",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_reflection_revision/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_reflection_revision/fixtures.py",
      "language": "python"
    },
    {
      "path": "course/execution.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "self-review",
      "title": "模型自评驱动修订",
      "question": "模型写正则，再由模型自己评审，评审说要改就修订，最多 3 轮。",
      "inputs": {
        "reviewer": "self",
        "max_iters": 3
      }
    },
    {
      "id": "test-review",
      "title": "测试结果驱动修订",
      "question": "模型写正则，由真实用例的测试结果评审，失败就带着失败用例修订，最多 3 轮。",
      "inputs": {
        "reviewer": "tests",
        "max_iters": 3
      }
    },
    {
      "id": "test-review-once",
      "title": "测试驱动，只允许 1 轮",
      "question": "同样用测试结果评审，但上限只有 1 轮，没有修订机会。",
      "inputs": {
        "reviewer": "tests",
        "max_iters": 1
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 8,
    "requires_model": true
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务固定为学号正则；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "reviewer": "tests",
    "max_iters": 3
  }
}
