    },
    {
      "path": "lessons/lesson_evaluation_sets/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_evaluation_sets/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_evaluation_sets/locales/en.py",
      "language": "python",
      "locale": "en"
    },
    {
      "path": "lessons/lesson_01_tool_selection/tools.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_03_fail_safely/tools.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_evaluation_sets/fixtures.py",
      "language": "python"
    },
    {
      "path": "course/execution.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "dev-compare",
      "title": "开发集：版本 A 对比版本 B",
      "question": {
        "zh-CN": "用开发集的 6 道题分别运行版本 A 和版本 B，逐题验收并做配对比较。",
        "en": "Run version A and version B on the 6 cases of the development set, verify every case and compare them pair by pair."
      },
      "inputs": {
        "task": "compare",
        "split": "dev",
        "versions": "both",
        "repeats": 1
      }
    },
    {
      "id": "holdout-compare",
      "title": "留出集：定好版本后跑一次",
      "question": {
        "zh-CN": "版本定下之后，用没参与修改的 4 道留出题再比较一次，看改善是否还在、有没有新的退化。",
        "en": "With the version chosen, compare once more on the 4 holdout cases that took no part in the changes: does the improvement hold, and is there a new regression?"
      },
      "inputs": {
        "task": "compare",
        "split": "holdout",
        "versions": "both",
        "repeats": 1
      }
    },
    {
      "id": "repeat-b",
      "title": "同一版本跑两次",
      "question": {
        "zh-CN": "版本 B 把开发集完整跑两次，找出两次结论不一致的题。",
        "en": "Run version B over the whole development set twice and find the cases whose verdict changes between runs."
      },
      "inputs": {
        "task": "compare",
        "split": "dev",
        "versions": "B",
        "repeats": 2
      }
    },
    {
      "id": "judge-calibration",
      "title": "评审模型与人工标注对照",
      "question": {
        "zh-CN": "让评审模型按量规给 6 条固定回答打分，再和作者事先写好的人工标注逐条对照。",
        "en": "Have the judge model grade 6 fixed answers by the rubric, then compare its verdicts one by one with the author's human annotations."
      },
      "inputs": {
        "task": "judge"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 80,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "题集、验证规则和两个版本由结构化预设决定；这里的文字只记进报告，不会发给模型。"
  },
  "input_defaults": {
    "task": "compare",
    "split": "dev",
    "versions": "both",
    "repeats": 1
  }
}
