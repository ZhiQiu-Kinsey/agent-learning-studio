  "exercises": [
    {
      "id": "grounded",
      "title": "有证据的问题",
      "question": {
        "zh-CN": "检索“逾期费用每册最高多少？”，把片段交给模型，逐条核对它的引用。",
        "en": "Retrieve for \"What is the maximum overdue charge per item?\", give the chunks to the model, and check each of its citations."
      },
      "inputs": {
        "query": "q03"
      }
    },
    {
      "id": "no-answer",
      "title": "资料里没有的问题",
      "question": {
        "zh-CN": "检索“图书馆有停车场吗？”：检索仍会返回片段，回答必须明确说资料不足。",
        "en": "Retrieve for \"Does the library have a car park?\": retrieval still returns chunks, and the answer must say plainly that the material is insufficient."
      },
      "inputs": {
        "query": "q07"
      }
    },
    {
      "id": "conflict",
      "title": "版本冲突的问题",
      "question": {
        "zh-CN": "检索“周日几点闭馆？”：2025 版和 2026 版都会被检索到，回答要列出两个来源并说明哪份为准。",
        "en": "Retrieve for \"What time does the library close on Sunday?\": both the 2025 and 2026 editions come back, and the answer must list both sources and say which applies."
      },
      "inputs": {
        "query": "q13"
      }
    },
    {
      "id": "triage",
      "title": "失败分类三题",
      "question": {
        "zh-CN": "连跑三题，分清检索未命中、引用了未提供的片段和命中后误用。",
        "en": "Run three questions in a row and tell apart a retrieval miss, a citation to a chunk that was not provided, and evidence that was found but misused."
      },
      "inputs": {
        "query": "triage"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 3,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "input_defaults": {
    "query": "q03",
    "top_k": 5
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "问题由参数里的查询编号决定，取自共享查询集；这里的文字只写进报告，不会发给模型。"
  }
}
