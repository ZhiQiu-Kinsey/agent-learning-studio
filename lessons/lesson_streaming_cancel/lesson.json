  ],
  "exercises": [
    {
      "id": "stream-vs-block",
      "title": "流式与非流式对照",
      "question": {
        "zh-CN": "同一条请求先流式、再非流式各发一次，比较首字延迟、总耗时和响应结构。",
        "en": "The same request is sent streamed and then not streamed; compare the time to first token, the total time and the shape of the response."
      },
      "inputs": {
        "scenario": "compare",
        "items": 6,
        "detail": "short"
      }
    },
    {
      "id": "long-stream",
      "title": "长输出：停止与断开",
      "question": {
        "zh-CN": "接收一份较长的清单，途中按“停止运行”或“断开事件连接”，再核对终态和已收到的内容。",
        "en": "Receive a long list as a stream; part-way through press \"Stop run\" or \"Disconnect the event stream\", then check the final state and what had arrived."
      },
      "inputs": {
        "scenario": "long",
        "items": 10,
        "detail": "long"
      }
    },
    {
      "id": "stop-after-n",
      "title": "程序在第 N 块后停止",
      "question": {
        "zh-CN": "程序在收到指定数量的数据块后结束流，看已收到的内容、完成原因和用量。",
        "en": "The program ends the stream after a set number of chunks; look at what arrived, the finish reason and the usage."
      },
      "inputs": {
        "scenario": "stop",
        "items": 8,
        "detail": "short",
        "stop_after_chunks": 12
      }
    },
    {
      "id": "partial-continue",
      "title": "不完整内容的下一轮",
      "question": {
        "zh-CN": "程序停止流后，把被截断的内容用两种方式交给模型续写：原样接上，或标注不完整。",
        "en": "After the program stops the stream, the cut text is handed back to the model in two ways: glued on as it is, or marked incomplete."
      },
      "inputs": {
        "scenario": "continue",
        "items": 8,
        "detail": "short",
        "stop_after_chunks": 40
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 3,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "input_defaults": {
    "scenario": "compare",
    "items": 6,
    "detail": "short",
    "stop_after_chunks": 12
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务、停止点和清单长度由参数决定；这里的文字只记为备注，不会发给模型。"
  },
  "testing": {
    "completion_factory": "fixtures:create_completion",
    "stream_factory": "fixtures:create_stream"
  }
}
