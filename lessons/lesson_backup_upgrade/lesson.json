  "exercises": [
    {
      "id": "online-backup",
      "title": "在线备份：复制文件与一致性备份",
      "question": {
        "zh-CN": "备份一份正在被写入的运行库和记忆库，再读回检查。",
        "en": "Back up a runs database and a memory database that are being written to, then read the copies back."
      },
      "inputs": {
        "scenario": "online_backup",
        "method": "naive_copy"
      }
    },
    {
      "id": "restore-drill",
      "title": "恢复演练：备份成功不等于能恢复",
      "question": {
        "zh-CN": "备份、核对清单，恢复到新目录，再用服务读数据的方式验收。",
        "en": "Back up, check the manifest, restore into a new directory, then accept it by reading the data like the service."
      },
      "inputs": {
        "scenario": "restore_drill"
      }
    },
    {
      "id": "upgrade-rollback",
      "title": "升级与回退：迁移 v1 到 v2",
      "question": {
        "zh-CN": "升级前备份，迁移两个数据文件；失败时回退，再检查服务和数据。",
        "en": "Back up before the upgrade, migrate both data files; on failure roll back, then check the service and the data."
      },
      "inputs": {
        "scenario": "upgrade_rollback",
        "failure": "fail_second_file",
        "safeguard": "backup"
      }
    },
    {
      "id": "retention",
      "title": "保留最近 N 份备份",
      "question": {
        "zh-CN": "做 6 份备份，损坏最新的几份，按策略清理后恢复。",
        "en": "Make 6 backups, damage the newest ones, prune by policy, then restore."
      },
      "inputs": {
        "scenario": "retention",
        "keep": 2,
        "corrupt_newest": 2,
        "policy": "newest_n_keep_verified"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 1,
    "requires_model": false,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "练习内容由结构化输入决定；备注只写进报告，不改变备份、恢复和升级的行为。"
  },
