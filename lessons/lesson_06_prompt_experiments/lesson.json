      "inputs": {
        "scenario": "flow_rule"
      }
    },
    {
      "id": "missing-input",
      "title": "失败边界：缺少加数",
      "question": "相同缺参任务，只调整 system 中的缺参规则。",
      "inputs": {
        "scenario": "missing_input"
      }
    },
    {
      "id": "tool-matrix",
      "title": "工具描述矩阵：空白、良好、误导",
      "question": "同一个 add_numbers，描述分别不写、写清楚、写错，各问一道求和题和一道拼接题。",
      "inputs": {
        "scenario": "tool_matrix"
      }
    }
  ],
