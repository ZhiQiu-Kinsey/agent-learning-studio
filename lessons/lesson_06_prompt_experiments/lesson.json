{
  "schema_version": 1,
  "id": "prompt-experiments",
  "subtitle": "同题同模型的提示与工具描述对照实验",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_06_prompt_experiments/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_06_prompt_experiments/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_06_prompt_experiments/locales/en.py",
      "language": "python",
      "locale": "en"
    },
    {
      "path": "course/execution.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "tool-description",
      "title": "工具描述：模糊与明确",
      "question": {
        "zh-CN": "相同加法任务，对照简短说明与明确的工具职责和参数。",
        "en": "The same addition task: a short description against one that states the tool's job and parameters."
      },
      "inputs": {
        "scenario": "tool_description"
      }
    },
    {
      "id": "flow-rule",
      "title": "流程规则：答案与核对",
      "question": {
        "zh-CN": "相同算术任务，只调整 system 中的处理流程。",
        "en": "The same arithmetic task; only the process in the system message changes."
      },
      "inputs": {
        "scenario": "flow_rule"
      }
    },
    {
      "id": "missing-input",
      "title": "失败边界：缺少加数",
      "question": {
        "zh-CN": "相同缺参任务，只调整 system 中的缺参规则。",
        "en": "The same task with a missing input; only the missing-input rule in the system message changes."
      },
      "inputs": {
        "scenario": "missing_input"
      }
    },
    {
      "id": "tool-matrix",
      "title": "工具描述矩阵：空白、良好、误导",
      "question": {
        "zh-CN": "同一个 add_numbers，描述分别不写、写清楚、写错，各问一道求和题和一道拼接题。",
        "en": "The same add_numbers with no description, a clear one and a wrong one; each is asked one sum probe and one concatenation probe."
      },
      "inputs": {
        "scenario": "tool_matrix"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 6,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务由结构化预设决定；备注会写入报告，不改变验收规则或配对条件。"
  },
  "input_defaults": {
    "scenario": "tool_description",
    "sample_label": {
      "zh-CN": "配对样本",
      "en": "paired sample"
    }
  }
}
