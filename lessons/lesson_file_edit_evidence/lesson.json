  "exercises": [
    {
      "id": "rewrite",
      "title": "整文件重写：write_file",
      "question": {
        "zh-CN": "只给模型 write_file：同一个修改任务，整个文件重写一遍。",
        "en": "Give the model only write_file: the same change task, by rewriting the whole file."
      },
      "inputs": {
        "scenario": "edit",
        "strategy": "rewrite"
      }
    },
    {
      "id": "replace",
      "title": "精确替换：edit_file",
      "question": {
        "zh-CN": "只给模型 edit_file：同一个修改任务，用唯一匹配的原文片段替换。",
        "en": "Give the model only edit_file: the same change task, by replacing a text that matches exactly once."
      },
      "inputs": {
        "scenario": "edit",
        "strategy": "replace"
      }
    },
    {
      "id": "lines",
      "title": "行号替换：edit_lines",
      "question": {
        "zh-CN": "只给模型 edit_lines：同一个修改任务，按 read_file 给出的行号替换。",
        "en": "Give the model only edit_lines: the same change task, by replacing lines at the numbers read_file shows."
      },
      "inputs": {
        "scenario": "edit",
        "strategy": "lines"
      }
    },
    {
      "id": "guards",
      "title": "五道防护（不调用模型）",
      "question": {
        "zh-CN": "运行器提交五组有问题的调用，看工具怎样拒绝、文件是否保持原样。",
        "en": "The runner submits five groups of flawed calls: see how the tools refuse them and whether the files stay as they were."
      },
      "requires_model": false,
      "inputs": {
        "scenario": "guards",
        "case": "all"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 10,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion",
    "approval_factory": "fixtures:create_approval_policy"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务固定为修复 shop/pricing.py；这里的文字只记入报告，不会发给模型。"
  },
  "input_defaults": {}
}
