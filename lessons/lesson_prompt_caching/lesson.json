{
  "schema_version": 1,
  "id": "prompt-caching",
  "subtitle": "同一份长资料连续问几次，看服务商复用了多少开头",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_prompt_caching/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_prompt_caching/cache_usage.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_prompt_caching/locales/handbook/zh_CN.md",
      "language": "text",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_prompt_caching/locales/handbook/en.md",
      "language": "text",
      "locale": "en"
    },
    {
      "path": "lessons/lesson_prompt_caching/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_prompt_caching/locales/en.py",
      "language": "python",
      "locale": "en"
    },
    {
      "path": "lessons/lesson_prompt_caching/fixtures.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "dynamic-first",
      "title": "动态内容在前",
      "question": {
        "zh-CN": "请求序号和发送时间写在系统提示词第一行，连续发 4 次同类请求。",
        "en": "Request number and send time go on the first line of the system prompt; send 4 similar requests in a row."
      },
      "inputs": {
        "layout": "dynamic_first"
      }
    },
    {
      "id": "stable-prefix",
      "title": "稳定前缀",
      "question": {
        "zh-CN": "同样的内容，请求序号和发送时间挪到最后一条 user 消息末尾，连续发 4 次。",
        "en": "Same content, with the request number and send time moved to the end of the last user message; send 4 in a row."
      },
      "inputs": {
        "layout": "stable_prefix"
      }
    },
    {
      "id": "warmup",
      "title": "稳定前缀 + 预热",
      "question": {
        "zh-CN": "先发一次只为写入缓存的预热请求，再按稳定前缀连续发 4 次。",
        "en": "First send one warmup request whose only purpose is to write the cache, then send 4 in a row with the stable prefix."
      },
      "inputs": {
        "layout": "warmup"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 6,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "请求内容由结构化参数决定；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "layout": "stable_prefix",
    "repeats": 4,
    "isolate_run": true
  }
}
