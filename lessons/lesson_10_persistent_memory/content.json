            {
              "id": "expiry-delete",
              "exercise": "expiry_delete",
              "label": "先写入，再让记录过期，最后删除并重开核对"
            }
          ],
          "observe": [
            {
              "id": "stale-rejected",
              "text": "冲突组的 stale_rejected：过时版本的写入被拒绝；同一事件中的 record 是用当前版本更新后的结果。",
              "selector": {
                "event": "lesson.memory",
                "path": "data.stale_rejected"
