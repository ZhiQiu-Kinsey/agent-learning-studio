      "inputs": {
        "scenario": "reopen"
      }
    },
    {
      "id": "recall_only",
      "title": "只读恢复上次记忆",
      "question": "不写入，只读取上次保存的学习目标",
      "inputs": {
        "scenario": "recall_only"
      }
    },
    {
      "id": "recall_answer",
      "title": "召回后让模型回答",
      "question": "把召回的记忆放进请求，问模型我的学习目标",
      "inputs": {
        "scenario": "recall_answer"
      }
    },
    {
      "id": "recall_other_namespace",
      "title": "换一个没有记忆的命名空间再问",
      "question": "从空的命名空间召回，再问同一个问题",
      "inputs": {
        "scenario": "recall_answer",
        "namespace": "new_learner"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 1,
    "requires_model": true
