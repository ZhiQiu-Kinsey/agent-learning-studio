  "exercises": [
    {
      "id": "reopen",
      "title": "保存与重开连接",
      "question": {
        "zh-CN": "写入学习目标，关闭连接后用新连接读回",
        "en": "Write the learning goal, close the connection, read it back on a new connection"
      },
      "inputs": {
        "scenario": "reopen"
      }
    },
    {
      "id": "recall_only",
      "title": "只读恢复上次记忆",
      "question": {
        "zh-CN": "不写入，只读取上次保存的学习目标",
        "en": "Do not write; only read the learning goal saved last time"
      },
      "inputs": {
        "scenario": "recall_only"
      }
    },
    {
      "id": "recall_answer",
      "title": "召回后让模型回答",
      "question": {
        "zh-CN": "把召回的记忆放进请求，问模型我的学习目标",
        "en": "Put the recalled memory into the request and ask the model for my learning goal"
      },
      "inputs": {
        "scenario": "recall_answer"
      }
    },
    {
      "id": "recall_other_namespace",
      "title": "换一个没有记忆的命名空间再问",
      "question": {
        "zh-CN": "从空的命名空间召回，再问同一个问题",
        "en": "Recall from an empty namespace, then ask the same question"
      },
      "inputs": {
        "scenario": "recall_answer",
        "namespace": "new_learner"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 1,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "读写什么由结构化输入决定；备注只写进报告，不会发给模型，也不改变读写行为。"
  },
  "input_defaults": {
    "value": {
      "zh-CN": "理解 Agent 的消息与状态",
      "en": "Understand an agent's messages and state"
    },
    "source": {
      "zh-CN": "本次学习者显式输入",
      "en": "entered explicitly by the learner this time"
    }
  }
}
