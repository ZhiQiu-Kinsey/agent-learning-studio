  "exercises": [
    {
      "id": "compare",
      "title": "三种压缩，同一个探针问题",
      "question": {
        "zh-CN": "压缩之后，最早那次工具结果还答得出来吗？",
        "en": "After compression, can the earliest tool result still be answered?"
      },
      "inputs": {
        "noise_repeats": 8,
        "char_budget": 300,
        "summary_style": "keep_sources"
      }
    },
    {
      "id": "tight-budget",
      "title": "规则压缩的预算装不下证据",
      "question": {
        "zh-CN": "字符预算小于关键证据时，规则压缩会怎么做？",
        "en": "What does rule-based compression do when the character budget is smaller than the key evidence?"
      },
      "inputs": {
        "noise_repeats": 8,
        "char_budget": 100,
        "summary_style": "keep_sources"
      }
    },
    {
      "id": "brief-summary",
      "title": "换一条简短的摘要指令",
      "question": {
        "zh-CN": "摘要指令只要求一两句话时，摘要还留着最早的来源和原话吗？",
        "en": "When the summary instruction asks for only one or two sentences, does the summary still keep the earliest source and its exact words?"
      },
      "inputs": {
        "noise_repeats": 8,
        "char_budget": 300,
        "summary_style": "brief"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 5,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "各组固定使用探针问题，这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "noise_repeats": 8,
    "char_budget": 300,
    "summary_style": "keep_sources"
  }
}
