{
  "schema_version": 1,
  "id": "structured-output",
  "subtitle": "三层检查模型生成的任务卡",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_05_structured_output/runtime.py",
      "language": "python"
    },
    {
      "path": "course/execution.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_05_structured_output/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_05_structured_output/locales/en.py",
      "language": "python",
      "locale": "en"
    }
  ],
  "exercises": [
    {
      "id": "normal",
      "title": "正常提取",
      "question": {
        "zh-CN": "从给定可信事实生成“任务目标与验收”一课的课程卡，并独立校验。",
        "en": "Generate the lesson card for the lesson \"Task goals and acceptance\" from the given trusted facts, and check it independently."
      },
      "inputs": {
        "scenario": "normal"
      }
    },
    {
      "id": "missing-field",
      "title": "故意缺字段",
      "question": {
        "zh-CN": "让模型第一轮故意省略先修字段，观察 Schema 与有限修复。",
        "en": "Have the model deliberately leave out the prerequisite field in round 1, and watch the schema check and the bounded repair."
      },
      "inputs": {
        "scenario": "missing_field"
      }
    },
    {
      "id": "wrong-fact",
      "title": "故意写错事实",
      "question": {
        "zh-CN": "让模型第一轮故意写错先修课程，观察结构合法也会失败。",
        "en": "Have the model deliberately get the prerequisite wrong in round 1, and see that a structurally valid card can still fail."
      },
      "inputs": {
        "scenario": "wrong_fact"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 2,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务由结构化预设决定；备注会写入报告，不改变验收规则或配对条件。"
  },
  "input_defaults": {
    "scenario": "normal",
    "repair": true
  }
}
