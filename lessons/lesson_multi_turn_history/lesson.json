{
  "schema_version": 1,
  "id": "multi-turn-history",
  "subtitle": "模型不记得上一轮，是程序把历史再发一遍",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_multi_turn_history/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_multi_turn_history/fixtures.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "with-history",
      "title": "带历史追问",
      "question": "第一轮告诉模型猫的名字，第二轮带着上一轮的问与答追问。",
      "inputs": {
        "history": "full",
        "turns": 2
      }
    },
    {
      "id": "without-history",
      "title": "不带历史追问",
      "question": "第一轮相同，第二轮只发第二个问题。",
      "inputs": {
        "history": "latest_only",
        "turns": 2
      }
    },
    {
      "id": "three-turns",
      "title": "三轮对话",
      "question": "带着历史连问三轮，看每轮的提示 Token。",
      "inputs": {
        "history": "full",
        "turns": 3
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 3,
    "requires_model": true
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "每轮的问题由练习预设决定；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "history": "full",
    "turns": 2
  }
}
