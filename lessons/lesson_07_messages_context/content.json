    "check": {
      "blocks": [
        {
          "id": "quiz",
          "type": "quiz",
          "questions": [
            {
              "id": "history",
              "prompt": "第二次调用为何能回答前一轮才给出的事实？",
              "options": [
                {
                  "id": "a",
                  "text": "模型自动保存所有浏览器对话"
                },
                {
                  "id": "b",
                  "text": "程序把前一轮消息重新放入本次 messages"
                },
                {
                  "id": "c",
                  "text": "页面回放提供了隐藏记忆"
                }
              ],
              "correct": "b",
              "explanation": "完整历史是否可见由本次请求决定。程序明确重发前一轮消息，模型才有这个证据。"
            },
            {
