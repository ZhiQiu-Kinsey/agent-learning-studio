  "scenes": {
    "understand": {
      "blocks": [
        {
          "id": "hero",
          "type": "hero",
          "eyebrow": "CHAPTER 03 / CONTEXT",
          "headline": "模型读到的历史，",
          "highlight": "由本次消息决定。",
          "takeaway": "历史要重发；工具消息要配对；答案只能按实际请求和响应判断。"
        },
        {
          "id": "concepts",
          "type": "concepts",
          "items": [
            {
              "id": "01-roles",
              "label": "01 / ROLES",
              "title": "消息角色",
              "description": "system、user、assistant 和 tool 有不同协议作用。",
              "token": "messages[]"
            },
            {
              "id": "02-replay",
              "label": "02 / REPLAY",
              "title": "历史重发",
              "description": "程序把上一轮消息再次放入请求，模型才可能用到。",
              "token": "append → complete"
            },
            {
              "id": "03-evidence",
              "label": "03 / EVIDENCE",
              "title": "合法消融",
              "description": "只移除可选历史，保持相同追问并检查实际请求。",
              "token": "full / omit"
            }
          ]
        },
        {
          "id": "section-1",
          "type": "prose",
          "title": "模型看到的是本次请求",
          "paragraphs": [
            "先写入事实，再进行追问。第二次调用能否使用先前事实，取决于程序是否把那轮消息重新放入 messages，也就是本次请求携带的消息历史（Message History）。RunContext.complete 会记录实际发送的 body；展开 request 才能确认可见上下文。上一轮出现在网页回放，不代表它自动进入下一轮模型请求。"
          ]
        },
        {
          "id": "section-2",
          "type": "prose",
          "title": "角色与轮次",
          "paragraphs": [
            "system 表达本课的回答约束，user 包含用户事实或追问，assistant 是模型已生成的回复。程序在第二次请求中加入第一次的 user 与 assistant 消息；这才是历史重发。模型供应商会把角色消息转换为自身格式，不能把页面上的消息列表误称为模型内部持久记忆。"
          ]
        },
        {
          "id": "mq-history-resent",
          "type": "micro-quiz",
          "question": {
            "id": "history-resent",
            "prompt": "第二次请求能用上第一次发出的事实，靠的是什么？",
            "options": [
              {
                "id": "a",
                "text": "程序把第一次的 user 与 assistant 消息重新放进了本次 messages",
                "feedback": "对。历史需要程序重发，模型才看得到。"
              },
              {
                "id": "b",
                "text": "模型在第一次请求后记住了事实",
                "feedback": "不对。模型没有跨请求的隐藏记忆。"
              },
              {
                "id": "c",
                "text": "网页回放里显示过第一次对话",
                "feedback": "不对。页面显示不等于发给了模型。"
              }
            ],
            "correct": "a",
            "explanation": "模型能用的上下文，只有本次请求携带的消息。"
          }
        },
        {
          "id": "section-3",
          "type": "prose",
          "title": "工具消息有配对规则",
          "paragraphs": [
            "工具调用（Tool Calling）先由 assistant 消息中的 tool_calls 提出，每个 id 后面必须有相应 role=tool 且 tool_call_id 相同的结果。孤立的 tool 回执或未补齐结果的调用可能被 API 拒绝。此课用验证器（Validator）validate_tool_history 做本地协议检查；真实对照没有工具调用，因此不虚构一条模型工具调用记录。"
          ]
        },
        {
          "id": "section-4",
          "type": "prose",
          "title": "做一次合法消融",
          "paragraphs": [
            "默认练习先向模型发送事实并取得真实回复，再用完整历史追问；第三次只保留 system 与相同追问。两条追问均是合法消息序列，变化的是可见事实。先检查请求是否被供应商接受，再比较证据是否出现在 messages，最后看答案是否正确；三者不能混为同一指标。"
          ]
        },
        {
          "id": "mq-ablation-order",
          "type": "micro-quiz",
          "question": {
            "id": "ablation-order",
            "prompt": "消融追问的回答是“无法从当前消息确定”。应该先核对什么？",
            "options": [
              {
                "id": "a",
                "text": "这次请求是否被正常接受，messages 里是否确实没有事实",
                "feedback": "对。先确认协议与可见性，再评价回答。"
              },
              {
                "id": "b",
                "text": "模型是不是出了故障",
                "feedback": "先别下结论。请求里没有事实时，这样回答正符合 system 的要求。"
              },
              {
                "id": "c",
                "text": "换一个更大的模型重跑",
                "feedback": "这样会引入新的变量，无法解释这次对照。"
              }
            ],
            "correct": "a",
            "explanation": "协议、可见性、回答三者要分开判断。"
          }
        },
        {
          "id": "section-5",
          "type": "prose",
          "title": "证据与边界",
          "paragraphs": [
            "报告里的消息数和可见事实布尔值由本次请求对象计算，回答文本来自真实 response。若移除历史后模型仍猜中事实，也不能据此声称它读到了已删除消息；若完整历史回答错误，也不能把它归为协议失败。页面上的流程动效是示意，具体运行证据应以 request、response 和报告事件为准。"
          ]
        },
        {
          "id": "walkthrough",
          "type": "walkthrough",
          "title": "三次请求，一次合法对照",
          "description": "以下代码是机制示意；真实字段和回答请到事件面板核对。",
          "steps": [
            {
              "id": "step-1",
              "label": "01",
              "actor": "程序",
              "title": "发送事实",
              "body": "第一轮只提供事实。",
              "code": "seed = [system, user_fact]\nfirst = context.complete({'messages': seed})",
              "language": "python",
              "evidence": "request / response"
            },
            {
              "id": "step-2",
              "label": "02",
              "actor": "程序",
              "title": "组成历史",
              "body": "第二轮加入第一次真实回答。",
              "code": "full = [*seed, assistant(first), follow_up]",
              "language": "python",
              "evidence": "request.messages"
            },
            {
              "id": "step-3",
              "label": "03",
              "actor": "程序",
              "title": "移除事实",
              "body": "对照请求保留相同追问。",
              "code": "omitted = [system, follow_up]",
              "language": "python",
              "evidence": "request.messages"
            },
            {
              "id": "step-4",
              "label": "04",
              "actor": "模型",
              "title": "返回回答",
              "body": "两次追问分别产生真实响应。",
              "code": "full_answer = context.complete({'messages': full})\nomit_answer = context.complete({'messages': omitted})",
              "language": "python",
              "evidence": "response"
            },
            {
              "id": "step-5",
              "label": "05",
              "actor": "验证器",
              "title": "归因差异",
              "body": "按协议、可见性、回答依次判断。",
              "code": "report = compare(full, omitted, responses)",
              "language": "python",
              "evidence": "lesson.report"
            }
          ]
        },
        {
          "id": "predict-request-count",
          "type": "predict",
          "prompt": "在实验中运行“事实 QH-731：完整历史与移除事实各追问一次”之前先猜：这次运行一共会发出几次模型请求（request 事件）？",
          "experiment": "history-ablation",
          "rule": {
            "kind": "count_events",
            "event": "request"
          }
        }
      ]
    },
