{
  "$schema": "../../curriculum/schema/content.v2.schema.json",
  "schema_version": 2,
  "lesson": "messages-context",
  "source_language": "zh-CN",
  "scenes": {
    "understand": {
      "blocks": [
        {
          "id": "hero",
          "type": "hero",
          "eyebrow": "CHAPTER 03 / CONTEXT",
          "headline": "模型读到的历史，",
          "highlight": "由本次消息决定。",
          "takeaway": "历史要重发；工具消息要配对；答案只能按实际请求和响应判断。"
        },
        {
          "id": "concepts",
          "type": "concepts",
          "items": [
            {
              "id": "01-roles",
              "label": "01 / ROLES",
              "title": "消息角色",
              "description": "system、user、assistant 和 tool 有不同协议作用。",
              "token": "messages[]"
            },
            {
              "id": "02-replay",
              "label": "02 / REPLAY",
              "title": "历史重发",
              "description": "程序把上一轮消息再次放入请求，模型才可能用到。",
              "token": "append → complete"
            },
            {
              "id": "03-evidence",
              "label": "03 / EVIDENCE",
              "title": "合法消融",
              "description": "只移除可选历史，保持相同追问并检查实际请求。",
              "token": "full / omit"
            }
          ]
        },
        {
          "id": "section-1",
          "type": "prose",
          "title": "模型看到的是本次请求",
          "paragraphs": [
            "先写入事实，再进行追问。第二次调用能否使用先前事实，取决于程序是否把那轮消息重新放入 messages。RunContext.complete 会记录实际发送的 body；展开 request 才能确认可见上下文。上一轮出现在网页回放，不代表它自动进入下一轮模型请求。"
          ]
        },
        {
          "id": "section-2",
          "type": "prose",
          "title": "角色与轮次",
          "paragraphs": [
            "system 表达本课的回答约束，user 包含用户事实或追问，assistant 是模型已生成的回复。程序在第二次请求中加入第一次的 user 与 assistant 消息；这才是历史重发。模型供应商会把角色消息转换为自身格式，不能把页面上的消息列表误称为模型内部持久记忆。"
          ]
        },
        {
          "id": "section-3",
          "type": "prose",
          "title": "工具消息有配对规则",
          "paragraphs": [
            "工具调用先由 assistant 消息中的 tool_calls 提出，每个 id 后面必须有相应 role=tool 且 tool_call_id 相同的结果。孤立的 tool 回执或未补齐结果的调用可能被 API 拒绝。此课通过 validate_tool_history 做本地协议检查；真实对照没有工具调用，因此不虚构一条模型工具调用记录。"
          ]
        },
        {
          "id": "section-4",
          "type": "prose",
          "title": "做一次合法消融",
          "paragraphs": [
            "默认练习先向模型发送事实并取得真实回复，再用完整历史追问；第三次只保留 system 与相同追问。两条追问均是合法消息序列，变化的是可见事实。先检查请求是否被供应商接受，再比较证据是否出现在 messages，最后看答案是否正确；三者不能混为同一指标。"
          ]
        },
        {
          "id": "section-5",
          "type": "prose",
          "title": "证据与边界",
          "paragraphs": [
            "报告里的消息数和可见事实布尔值由本次请求对象计算，回答文本来自真实 response。若移除历史后模型仍猜中事实，也不能据此声称它读到了已删除消息；若完整历史回答错误，也不能把它归为协议失败。页面上的流程动效是示意，具体运行证据应以 request、response 和报告事件为准。"
          ]
        },
        {
          "id": "walkthrough",
          "type": "walkthrough",
          "title": "三次请求，一次合法对照",
          "description": "以下代码是机制示意；真实字段和回答请到事件面板核对。",
          "steps": [
            {
              "id": "step-1",
              "label": "01",
              "actor": "程序",
              "title": "发送事实",
              "body": "第一轮只提供事实。",
              "code": "seed = [system, user_fact]\nfirst = context.complete({'messages': seed})",
              "language": "python",
              "evidence": "request / response"
            },
            {
              "id": "step-2",
              "label": "02",
              "actor": "程序",
              "title": "组成历史",
              "body": "第二轮加入第一次真实回答。",
              "code": "full = [*seed, assistant(first), follow_up]",
              "language": "python",
              "evidence": "request.messages"
            },
            {
              "id": "step-3",
              "label": "03",
              "actor": "程序",
              "title": "移除事实",
              "body": "对照请求保留相同追问。",
              "code": "omitted = [system, follow_up]",
              "language": "python",
              "evidence": "request.messages"
            },
            {
              "id": "step-4",
              "label": "04",
              "actor": "模型",
              "title": "返回回答",
              "body": "两次追问分别产生真实响应。",
              "code": "full_answer = context.complete({'messages': full})\nomit_answer = context.complete({'messages': omitted})",
              "language": "python",
              "evidence": "response"
            },
            {
              "id": "step-5",
              "label": "05",
              "actor": "验证器",
              "title": "归因差异",
              "body": "按协议、可见性、回答依次判断。",
              "code": "report = compare(full, omitted, responses)",
              "language": "python",
              "evidence": "lesson.report"
            }
          ]
        }
      ]
    },
    "code": {
      "blocks": [
        {
          "id": "code-whats-new",
          "type": "whats-new"
        },
        {
          "id": "code-ablation",
          "type": "annotated-source",
          "path": "lessons/lesson_07_messages_context/runtime.py",
          "start": 54,
          "end": 89,
          "notes": [
            {
              "id": "n56",
              "line": 56,
              "text": "学习者输入的问题优先作为追问；为空时才用参数里的默认追问。"
            },
            {
              "id": "n57",
              "line": 57,
              "text": "visible 只检查实际发出的消息内容。“事实在不在请求里”由程序判断，不依赖模型回答。"
            },
            {
              "id": "n65",
              "line": 65,
              "text": "完整历史 = 第一轮消息 + 模型第一次的真实回答 + 追问。历史由程序显式重发。"
            },
            {
              "id": "n71",
              "line": 71,
              "text": "消融版只保留 system 和追问：事实连同模型的确认一起移除，消息序列仍然合法。"
            }
          ]
        },
        {
          "id": "code-history-protocol",
          "type": "annotated-source",
          "path": "lessons/lesson_07_messages_context/runtime.py",
          "start": 28,
          "end": 51,
          "notes": [
            {
              "id": "n34",
              "line": 34,
              "text": "有未回执的工具调用时，下一条必须是 tool 消息。"
            },
            {
              "id": "n45",
              "line": 45,
              "text": "孤立或重复的 tool 回执直接拒绝，避免构造出服务商会拒收的历史。"
            },
            {
              "id": "n50",
              "line": 50,
              "text": "结尾仍有调用没有回执也算不合法。"
            }
          ]
        },
        {
          "id": "code-stateless-fixture",
          "type": "annotated-source",
          "path": "lessons/lesson_07_messages_context/fixtures.py",
          "start": 10,
          "end": 18,
          "notes": [
            {
              "id": "n12",
              "line": 12,
              "text": "离线夹具按本次 messages 的形状判断是第一轮确认。"
            },
            {
              "id": "n14",
              "line": 14,
              "text": "只要事实出现在本次消息里就能答出，否则回答无法确定。夹具不保存任何隐藏状态，模拟的正是无状态模型。"
            }
          ]
        },
        {
          "id": "code-decision",
          "type": "decision",
          "title": "用合法的消融对照证明“模型只看本次请求”",
          "chosen": "同一追问发两次：一次带完整历史，一次移除事实所在的消息；两份历史都先通过 validate_tool_history，再对照 request 的 messages 与 response。",
          "alternatives": [
            {
              "id": "full-only",
              "title": "只发完整历史，看模型能不能答对",
              "why_not": "答对无法区分是来自历史还是模型猜中，缺少对照组。"
            },
            {
              "id": "broken-history",
              "title": "随意删一条消息（例如留下孤立的 tool 回执）",
              "why_not": "服务商可能直接拒绝请求，失败原因变成协议错误而不是缺少信息；协议检查在发送前拦截这类序列。"
            }
          ]
        }
      ]
    },
