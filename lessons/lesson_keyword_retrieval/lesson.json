  "exercises": [
    {
      "id": "query-table",
      "title": "整个查询集的命中表",
      "question": {
        "zh-CN": "用 BM25 检索查询集的 14 条查询，记录前 5 条结果、首个命中名次和漏检",
        "en": "Search all 14 queries of the query set with BM25; record the top 5, the first hit rank and the misses"
      },
      "inputs": {
        "scenario": "query_table",
        "top_k": 5,
        "k1": 1.5,
        "b": 0.75
      }
    },
    {
      "id": "explain-score",
      "title": "拆开一条结果的得分",
      "question": {
        "zh-CN": "把查询集 q03 的第 1 条结果逐词拆开：逆文档频率、词频、长度归一化",
        "en": "Take the top result of query q03 apart term by term: IDF, term frequency, length normalization"
      },
      "inputs": {
        "scenario": "explain",
        "query_id": "q03",
        "top_k": 5,
        "k1": 1.5,
        "b": 0.75
      }
    },
    {
      "id": "misses",
      "title": "漏检与无答案查询",
      "question": {
        "zh-CN": "同义改写的查询为什么漏检？资料里没有答案时 BM25 返回什么？",
        "en": "Why do reworded queries miss? What does BM25 return when the handbook has no answer?"
      },
      "inputs": {
        "scenario": "misses",
        "top_k": 5,
        "k1": 1.5,
        "b": 0.75
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 1,
    "requires_model": false,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "检索内容由结构化输入决定；备注只写进报告，不改变检索和判定。"
  },
  "input_defaults": {}
}
