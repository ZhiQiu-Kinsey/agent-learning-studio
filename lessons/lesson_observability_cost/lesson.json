      "path": "course/execution.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "baseline",
      "title": "基线：逐条请求、不缓存",
      "question": {
        "zh-CN": "按基线核对 4 条报销：每条请求一次模型，每次都调用工具。",
        "en": "Check the 4 receipts with the baseline: one model request per receipt, the tools called every time."
      },
      "inputs": {
        "strategy": "baseline",
        "compare_with_baseline": false
      }
    },
    {
      "id": "tool-cache",
      "title": "只开工具缓存",
      "question": {
        "zh-CN": "和基线只差一处：同样的工具调用在本次运行内只执行一次。",
        "en": "One change from the baseline: the same tool call runs only once within the run."
      },
      "inputs": {
        "strategy": "tool_cache",
        "compare_with_baseline": false
      }
    },
    {
      "id": "batched-compare",
      "title": "合并请求，并与基线对照",
      "question": {
        "zh-CN": "先跑一遍基线，再只改一处：4 条报销合进一次模型请求；同一题集比较质量、耗时和用量。",
        "en": "Run the baseline first, then change one thing: all 4 receipts go into one model request; compare quality, time and usage on the same question set."
      },
      "inputs": {
        "strategy": "batched",
        "compare_with_baseline": true
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 8,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务固定为 4 条报销；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "strategy": "baseline",
    "compare_with_baseline": false,
    "rate_latency_ms": 200,
    "price_input_per_m": 0,
    "price_output_per_m": 0,
    "price_currency": "CNY",
    "price_source": "",
    "price_date": ""
  }
}
