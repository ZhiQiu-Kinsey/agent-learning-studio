{
  "schema_version": 1,
  "id": "todo-planning",
  "subtitle": "让 Agent 自己记清单，再由验收器判断做没做完",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_todo_planning/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_todo_planning/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_todo_planning/locales/en.py",
      "language": "python",
      "locale": "en"
    },
    {
      "path": "lessons/lesson_todo_planning/fixtures.py",
      "language": "python"
    },
    {
      "path": "course/runner.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "no-todo",
      "title": "无 TODO",
      "question": {
        "zh-CN": "不给 todo_write，让模型直接完成三课复习卡。",
        "en": "No todo_write: the model does the three-lesson review card directly."
      },
      "inputs": {
        "condition": "no_todo"
      }
    },
    {
      "id": "todo",
      "title": "有 TODO，无提醒",
      "question": {
        "zh-CN": "提供 todo_write 并要求先列清单，运行层不提醒。",
        "en": "todo_write is offered and the model must list the steps first; the harness sends no reminder."
      },
      "inputs": {
        "condition": "todo"
      }
    },
    {
      "id": "todo-reminder",
      "title": "有 TODO，有提醒",
      "question": {
        "zh-CN": "提供 todo_write；连续 2 轮没更新清单时，运行层插入一条提醒。",
        "en": "todo_write is offered; after 2 rounds in a row without a list update, the harness inserts a reminder."
      },
      "inputs": {
        "condition": "todo_reminder",
        "reminder_after": 2
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 10,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务固定为三课复习卡；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "condition": "todo_reminder",
    "reminder_after": 2
  }
}
