              "title": "执行模型提出的调用",
              "body": "lookup_note、save_card 做实际工作，todo_write 只改清单。",
              "code": "result = execute_tool(call, tools)",
              "language": "python",
              "evidence": "tool_call 与 tool_result"
            },
            {
              "id": "step-3",
              "label": "快照",
              "actor": "运行器",
              "title": "清单变了就记一版",
              "body": "发布完整清单和差异。",
              "code": "context.emit(\"lesson.todo\", {\"version\": v, \"todos\": todos, \"diff\": diff})",
              "language": "python",
              "evidence": "lesson.todo"
            },
            {
              "id": "step-4",
              "label": "计数",
              "actor": "运行器",
              "title": "数一数多少轮没更新",
              "body": "本轮调用过 todo_write 就清零，否则加一。",
              "code": "since_update = 0 if updated else since_update + 1",
              "language": "python"
            },
            {
              "id": "step-5",
              "label": "提醒",
              "actor": "运行器",
              "title": "到阈值就插入提醒",
              "body": "放在本轮 tool 消息之后，并记成一条运行层插入事件。",
              "code": "messages.append({\"role\": \"user\", \"content\": reminder_text(n)})",
              "language": "python",
              "evidence": "lesson.harness_injected"
            }
          ]
        },
        {
          "id": "predict-reminders",
