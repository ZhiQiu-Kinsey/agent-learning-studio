      "inputs": {
        "pattern": "routing"
      }
    },
    {
      "id": "serial",
      "title": "三个子任务，串行",
      "question": "三个互不依赖的复述任务，一个接一个发出。",
      "inputs": {
        "pattern": "serial"
      }
    },
    {
      "id": "parallel",
      "title": "三个子任务，并行",
      "question": "同样三个复述任务，同时发出。",
      "inputs": {
        "pattern": "parallel"
      }
    }
  ],
