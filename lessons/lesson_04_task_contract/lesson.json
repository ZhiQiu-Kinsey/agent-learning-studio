  ],
  "exercises": [
    {
      "id": "normal",
      "title": "正常：计算并验收",
      "question": "依据本地计算 19 + 23，并判断任务是否通过。",
      "inputs": {
        "scenario": "normal"
      }
    },
    {
      "id": "missing-evidence",
      "title": "只有声明，没有证据",
      "question": "执行者声称答案是 42，但没有调用工具，同一任务卡如何判定？",
      "inputs": {
        "scenario": "missing_evidence"
      }
    },
    {
      "id": "wrong-result",
      "title": "证据存在，结果错误",
      "question": "工具确实执行但返回值不满足预期，是否可以声称完成？",
      "inputs": {
        "scenario": "wrong_result"
      }
    },
    {
      "id": "claim-mismatch",
      "title": "声明与证据不一致",
      "question": "工具返回 41，执行者却声明 42，验收器看哪一个？",
      "inputs": {
        "scenario": "claim_mismatch"
      }
    },
    {
      "id": "goal-loop",
      "title": "有上限的目标循环：最多 3 次",
      "question": "第一次尝试未通过验收时，带着原因重试，最多 3 次。",
      "inputs": {
        "scenario": "goal_loop",
        "max_attempts": 3
      }
    },
    {
      "id": "goal-loop-once",
      "title": "有上限的目标循环：只允许 1 次",
      "question": "同样的循环，上限改为 1 次，会停在哪里？",
      "inputs": {
        "scenario": "goal_loop",
        "max_attempts": 1
      }
    }
  ],
  "runtime": {
    "kind": "custom",
