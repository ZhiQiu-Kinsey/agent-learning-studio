              "language": "python",
              "evidence": "tool_call 与 tool_result"
            },
            {
              "id": "step-3",
              "label": "声明",
              "actor": "执行者",
              "title": "提交完成声明",
              "body": "声明里有答案和 evidence_ref。它只是说法，还没被核对。",
              "code": "claim = {\"status\": \"done\", \"answer\": 42, \"evidence_ref\": call_id}",
              "language": "python",
              "evidence": "lesson.completion_claim 事件"
            },
            {
