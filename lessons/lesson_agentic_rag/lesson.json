  "exercises": [
    {
      "id": "static",
      "title": "静态 RAG：一次检索 + 一次回答",
      "question": {
        "zh-CN": "用问题原文检索一次，模型只依据这次的片段回答一次。",
        "en": "Search once with the question as written; the model answers once from those chunks only."
      },
      "inputs": {
        "mode": "static",
        "question_id": "q11"
      }
    },
    {
      "id": "agentic",
      "title": "Agentic RAG：拆成子问题，补查第二跳",
      "question": {
        "zh-CN": "模型自己决定查什么、查几次；最多 4 次检索、5 次模型调用。",
        "en": "The model decides what to search and how often; at most 4 searches and 5 model calls."
      },
      "inputs": {
        "mode": "agentic",
        "question_id": "q11",
        "max_searches": 4,
        "max_model_calls": 5
      }
    },
    {
      "id": "no-answer",
      "title": "无答案问题：在预算内停下",
      "question": {
        "zh-CN": "手册里没有答案的问题，最多 3 次检索。",
        "en": "A question the handbook cannot answer, at most 3 searches."
      },
      "inputs": {
        "mode": "agentic",
        "question_id": "q07",
        "max_searches": 3,
        "max_model_calls": 5
      }
    },
    {
      "id": "one-search",
      "title": "只允许 1 次检索",
      "question": {
        "zh-CN": "同一道多跳问题，检索上限改成 1 次。",
        "en": "The same multi-hop question with a search limit of 1."
      },
      "inputs": {
        "mode": "agentic",
        "question_id": "q11",
        "max_searches": 1,
        "max_model_calls": 5
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 8,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "input_defaults": {
    "mode": "agentic",
    "question_id": "q11",
    "max_searches": 4,
    "max_model_calls": 5,
    "time_budget_s": 60,
    "top_k": 3
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "问题从共享题集里按编号选取；这里的文字只记为备注，不会发给模型。"
  }
}
