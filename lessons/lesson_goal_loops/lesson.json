{
  "schema_version": 1,
  "id": "goal-loops",
  "subtitle": "谁说了算：执行者说完成，还是评估说完成",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_goal_loops/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_goal_loops/locales/zh_CN.py",
      "language": "python",
      "locale": "zh-CN"
    },
    {
      "path": "lessons/lesson_goal_loops/locales/en.py",
      "language": "python",
      "locale": "en"
    },
    {
      "path": "lessons/lesson_goal_loops/fixtures.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "reachable",
      "title": "可达目标：预算内完成",
      "question": {
        "zh-CN": "按四份资料填写读书会通知卡（日期、教室、开始时间），最多 5 轮。",
        "en": "Fill in the reading group notice card (date, room, start time) from four notes, at most 5 rounds."
      },
      "inputs": {
        "goal": "notice",
        "worker_style": "careful",
        "max_rounds": 5
      }
    },
    {
      "id": "missing-info",
      "title": "不可达目标：资料里没有联系电话",
      "question": {
        "zh-CN": "同一张通知卡再加一个联系电话，可四份资料里都没有电话。",
        "en": "The same notice card plus a contact phone, but none of the four notes has a phone number."
      },
      "inputs": {
        "goal": "notice_with_phone",
        "worker_style": "careful",
        "max_rounds": 5
      }
    },
    {
      "id": "tight-budget",
      "title": "预算太小：有进展，但轮数用完",
      "question": {
        "zh-CN": "可达的通知卡，但只给 2 轮。",
        "en": "The reachable notice card, but only 2 rounds."
      },
      "inputs": {
        "goal": "notice",
        "worker_style": "careful",
        "max_rounds": 2
      }
    },
    {
      "id": "false-done",
      "title": "执行者自报完成，评估不通过",
      "question": {
        "zh-CN": "执行者的提示词要它尽快交差、第一轮就报完成；评估照旧只看完成条件。",
        "en": "The worker's prompt tells it to finish fast and claim done in round 1; the evaluation still checks only the completion condition."
      },
      "inputs": {
        "goal": "notice",
        "worker_style": "hasty",
        "max_rounds": 5
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 20,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务固定为读书会通知卡；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "goal": "notice",
    "worker_style": "careful",
    "max_rounds": 5,
    "max_model_calls": 12,
    "max_seconds": 180,
    "max_stall": 2,
    "repeat_limit": 2
  }
}
