{
  "schema_version": 1,
  "id": "text-actions",
  "subtitle": "同一个查询，用文本协议和原生工具调用各做一遍",
  "content": "content.json",
  "sources": [
    {
      "path": "lessons/lesson_text_actions/runtime.py",
      "language": "python"
    },
    {
      "path": "lessons/lesson_text_actions/fixtures.py",
      "language": "python"
    },
    {
      "path": "course/execution.py",
      "language": "python"
    }
  ],
  "exercises": [
    {
      "id": "text-stop",
      "title": "文本协议，带 stop",
      "question": "用 Thought / Action / Observation 文本协议查询 s-1042 的成绩，请求带 stop。",
      "inputs": {
        "protocol": "text_stop",
        "student_id": "s-1042"
      }
    },
    {
      "id": "text-no-stop",
      "title": "文本协议，去掉 stop",
      "question": "同一个文本协议，去掉 stop，看模型会不会自己写 Observation。",
      "inputs": {
        "protocol": "text_no_stop",
        "student_id": "s-1042"
      }
    },
    {
      "id": "native",
      "title": "原生工具调用",
      "question": "同一个问题，改用 tools 参数和 tool_calls。",
      "inputs": {
        "protocol": "native",
        "student_id": "s-1042"
      }
    },
    {
      "id": "text-no-stop-fail",
      "title": "去掉 stop，换一个不及格的学生",
      "question": "s-2077 的真实分数在及格线以下，去掉 stop 时模型自写的 Observation 会不会给出相反的结论？",
      "inputs": {
        "protocol": "text_no_stop",
        "student_id": "s-2077"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 4,
    "requires_model": true
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "问题由结构化预设决定；这里的文字只记为备注，不会发给模型。"
  },
  "input_defaults": {
    "protocol": "text_stop",
    "student_id": "s-1042"
  }
}
