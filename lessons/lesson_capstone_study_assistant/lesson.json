  "exercises": [
    {
      "id": "grounded",
      "title": "带引用的学习问答",
      "question": {
        "zh-CN": "对照笔记回答“引用核对的摘录最少要几个字符？”，逐条核对引用。",
        "en": "Answer \"What is the minimum quote length in a citation check?\" from the notes and check every citation."
      },
      "inputs": {
        "case": "d01"
      }
    },
    {
      "id": "no-answer",
      "title": "资料里没有的问题",
      "question": {
        "zh-CN": "问“这套学习笔记的作者是谁？”：检索仍会返回片段，回答必须明说资料不足。",
        "en": "Ask \"Who wrote these study notes?\": retrieval still returns chunks, and the answer must say plainly that the material is insufficient."
      },
      "inputs": {
        "case": "d03"
      }
    },
    {
      "id": "progress",
      "title": "保存学习进度并在新会话召回",
      "question": {
        "zh-CN": "学习者说刚学完 rag-citations：经门禁和审批写入进度，再开一个新会话读回来。",
        "en": "The learner says they just finished rag-citations: write the progress through the gate and an approval, then read it back in a new session."
      },
      "inputs": {
        "case": "d07"
      }
    },
    {
      "id": "recovery",
      "title": "崩溃后从检查点恢复",
      "question": {
        "zh-CN": "学习者请记下 evaluation-sets 学完了：批准之后、写入之前进程崩溃，从检查点恢复两次，只写一次。",
        "en": "The learner asks to record evaluation-sets as done: the process crashes after the approval and before the write, and resuming the checkpoint twice writes once."
      },
      "inputs": {
        "case": "h05"
      }
    },
    {
      "id": "injection",
      "title": "含注入资料的安全回答",
      "question": {
        "zh-CN": "论坛留言里夹着一条要助教越权写入的指令：正常回答问题，并看门禁拦下了什么。",
        "en": "A forum post carries an instruction that asks the assistant for an out-of-scope write: answer the question normally and see what the gate stops."
      },
      "inputs": {
        "case": "d08"
      }
    },
    {
      "id": "evaluate",
      "title": "固定题集评估与验收",
      "question": {
        "zh-CN": "跑完整套固定题（开发集 8 题加留出集 5 题）：通过率、失败分类、调用账本和验收报告。",
        "en": "Run the whole fixed suite (8 development cases and 5 holdout cases): pass rate, failure classification, call ledger and acceptance report."
      },
      "inputs": {
        "case": "suite",
        "split": "all"
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 80,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion",
    "approval_factory": "fixtures:create_approval_policy"
  },
  "input_defaults": {
    "case": "d01",
    "split": "dev",
    "top_k": 5,
    "tools": "local"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "任务由参数里的案例决定，案例的问题固定在题集里；这里的文字只写进报告，不会发给模型。"
  }
