  "exercises": [
    {
      "id": "compare-cards",
      "title": "整理复习卡：两种方式对照",
      "question": {
        "zh-CN": "同一个整理笔记的任务，先全量注入，再用目录加按需加载。",
        "en": "The same note-organizing task, first with full injection, then with the catalog and on-demand loading."
      },
      "inputs": {
        "mode": "both",
        "task": "make_cards",
        "description": "precise"
      }
    },
    {
      "id": "compare-chat",
      "title": "闲聊：两种方式对照",
      "question": {
        "zh-CN": "一句和技能无关的问候，两种方式各发一次。",
        "en": "A greeting unrelated to any skill, sent once in each mode."
      },
      "inputs": {
        "mode": "both",
        "task": "chat",
        "description": "precise"
      }
    },
    {
      "id": "cards-precise",
      "title": "整理复习卡：精确描述",
      "question": {
        "zh-CN": "只用目录加按需加载，review-cards 的描述写清用法。",
        "en": "Catalog and on-demand loading only, with a review-cards description that states when to use it."
      },
      "inputs": {
        "mode": "on_demand",
        "task": "make_cards",
        "description": "precise"
      }
    },
    {
      "id": "cards-vague",
      "title": "整理复习卡：模糊描述",
      "question": {
        "zh-CN": "review-cards 的描述改成“帮助学习。”，看还会不会加载。",
        "en": "The review-cards description is changed to \"Helps with studying.\"; does it still get loaded?"
      },
      "inputs": {
        "mode": "on_demand",
        "task": "make_cards",
        "description": "vague"
      }
    },
    {
      "id": "question-precise",
      "title": "复习提问：精确描述",
      "question": {
        "zh-CN": "只问一个知识点、没有给笔记，本课认定不该加载任何技能。",
        "en": "A single question with no notes; this lesson expects no skill to be loaded."
      },
      "inputs": {
        "mode": "on_demand",
        "task": "review_question",
        "description": "precise"
      }
    },
    {
      "id": "question-vague",
      "title": "复习提问：模糊描述",
      "question": {
        "zh-CN": "描述改成“帮助学习。”后，同一个复习提问会不会误加载 review-cards。",
        "en": "With the description changed to \"Helps with studying.\", does the same review question falsely load review-cards?"
      },
      "inputs": {
        "mode": "on_demand",
        "task": "review_question",
        "description": "vague"
      }
    }
  ],
