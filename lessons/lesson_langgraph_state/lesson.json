  "exercises": [
    {
      "id": "normal",
      "title": "正常路径：规划、调用、验证、回答",
      "question": {
        "zh-CN": "三门课、每天 30 分钟：图从 intake 走到 answer，中间每次分支读的是哪个状态字段？",
        "en": "Three lessons at 30 minutes a day: the graph goes from intake to answer. Which state field does each branch read?"
      },
      "inputs": {
        "lessons": "chat-request, tool-selection, application-state",
        "minutes_per_day": 30
      }
    },
    {
      "id": "missing",
      "title": "缺参：没说每天学多久",
      "question": {
        "zh-CN": "没给每天分钟数：图在哪个节点结束，模型被调用了几次？",
        "en": "No minutes per day: at which node does the graph end, and how many times is the model called?"
      },
      "inputs": {
        "lessons": "chat-request, tool-selection",
        "minutes_per_day": null
      }
    },
    {
      "id": "repair-fail",
      "title": "失败终态：修正一次仍不通过",
      "question": {
        "zh-CN": "课程表里没有的课：校验失败后回到 plan 修正一次，再失败就走到 fail。",
        "en": "A lesson that is not in the table: after a failed check the graph goes back to plan once, then ends at fail."
      },
      "inputs": {
        "lessons": "application-state, agent-magic",
        "minutes_per_day": 30,
        "max_repairs": 1
      }
    },
    {
      "id": "recursion-limit",
      "title": "上限截停：recursion_limit 先到",
      "question": {
        "zh-CN": "修正次数放宽到 3，recursion_limit 收紧到 6：谁先让图停下，停在哪里？",
        "en": "Repairs raised to 3, recursion_limit lowered to 6: which limit stops the graph first, and where?"
      },
      "inputs": {
        "lessons": "application-state, agent-magic",
        "minutes_per_day": 30,
        "max_repairs": 3,
        "recursion_limit": 6
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 6,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion"
  },
  "ui": {
    "lab": "structured-inputs",
    "inspector": "evidence-board",
    "question_label": "学习者备注",
    "question_help": "图的输入由结构化参数决定；这里的文字只写进报告，不发给模型，也不影响分支。"
  },
  "input_defaults": {
    "lessons": "chat-request, tool-selection, application-state",
    "minutes_per_day": 30,
    "max_repairs": 1,
    "recursion_limit": 25
  }
}
