  "exercises": [
    {
      "id": "compare",
      "title": "同一查询集比较三种检索",
      "question": {
        "zh-CN": "用同一份资料和 14 条固定查询，分别运行关键词、向量和混合检索，对照每种结果的命中。",
        "en": "Run keyword, vector and hybrid retrieval on the same corpus and the 14 fixed queries, and compare the hits of each result."
      },
      "inputs": {
        "task": "compare",
        "top_k": 5,
        "rrf_k": 60
      }
    },
    {
      "id": "rerank-synonym",
      "title": "重排：同义改写查询",
      "question": {
        "zh-CN": "把“闭馆以后去哪里还书？”的前 8 个融合结果交给模型重排，比较前 3 条在重排前后的命中。",
        "en": "Send the top 8 fused results for \"Where can I drop off books after closing time?\" to the model for reranking, and compare the top 3 before and after."
      },
      "inputs": {
        "task": "rerank",
        "top_k": 3,
        "candidates": 8,
        "query_id": "q06"
      }
    },
    {
      "id": "rerank-exact",
      "title": "重排：精确编号查询",
      "question": {
        "zh-CN": "把“R-305 有几个座位？”的前 8 个融合结果交给模型重排，比较前 3 条在重排前后的命中。",
        "en": "Send the top 8 fused results for \"How many seats does R-305 have?\" to the model for reranking, and compare the top 3 before and after."
      },
      "inputs": {
        "task": "rerank",
        "top_k": 3,
        "candidates": 8,
        "query_id": "q02"
      }
    },
    {
      "id": "update",
      "title": "元数据过滤与索引更新",
      "question": {
        "zh-CN": "先比较不过滤和只保留最新版的结果，再在工作副本里修改一份资料、删除旧版，更新索引并重新载入核对。",
        "en": "Compare unfiltered results with newest-version-only results, then edit one document and delete the old version in the working copy, update the index and reload it to check."
      },
      "inputs": {
        "task": "update",
        "top_k": 5
      }
    }
  ],
  "runtime": {
    "kind": "custom",
    "entrypoint": "runtime:run",
    "max_rounds": 8,
    "requires_model": true,
    "locales": [
      "zh-CN",
      "en"
    ]
  },
  "testing": {
    "completion_factory": "fixtures:create_completion",
    "embedding_factory": "fixtures:create_embedding"
  },
  "input_defaults": {
    "task": "compare",
    "top_k": 5,
    "rrf_k": 60,
    "candidates": 8,
    "query_id": "q06"
  },
  "ui": {
    "lab": "structured-inputs",
